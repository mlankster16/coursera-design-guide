---
import PageLayout from '../layouts/PageLayout.astro';
import WorkedExample from '../components/WorkedExample.astro';
import BestPractice from '../components/BestPractice.astro';

const stats = [
  { figure: '1–3 learning objectives', label: 'per Module' },
  { figure: '~30 minutes minimum', label: 'of learner time' },
  { figure: '0–5 lessons*', label: '*optional grouping' },
  { figure: '1 graded assessment', label: 'required per Module' },
];

const steps = [
  { id: 'step1', n: 1, label: 'Write objectives' },
  { id: 'step2', n: 2, label: 'Plan backward' },
  { id: 'step3', n: 3, label: 'Design learning path' },
  { id: 'step4', n: 4, label: 'Choose assets' },
  { id: 'step5', n: 5, label: 'Complete the plan' },
];

/* Purple scale, darkening across the five steps. */
const badge = ['#6B4E9E', '#5A3F87', '#493274', '#3A2760', '#8A5A0B'];

const moduleObjectives = [
  'Identify the data needed to investigate a business question.',
  'Evaluate an available dataset for relevance, completeness, and basic quality concerns.',
  'Document limitations that could affect the proposed analysis.',
];

const planningQuestions = [
  {
    n: 1,
    title: 'The final task',
    body: 'What will learners do, create, analyze, evaluate, or decide to show that they have achieved the Module objectives?',
  },
  {
    n: 2,
    title: 'What a successful response looks like',
    body: 'What should learners include, do, or decide to complete the task successfully? How will the activity help learners recognize whether they have met the expectations?',
  },
  {
    n: 3,
    title: 'What learners already know',
    body: 'What should learners already know or be able to do before they begin?',
  },
  {
    n: 4,
    title: 'What learners still need to learn',
    body: 'What new knowledge, steps, or decision-making skills do learners need to develop? Where might they become confused or make mistakes?',
  },
  {
    n: 5,
    title: 'How learners will know they are on track',
    body: 'What feedback, answer explanation, model, checklist, or other support will help learners judge their own work?',
  },
];

const evidenceRows = [
  {
    objective: 'Identify the data needed',
    evidence:
      'Specify the variables, records, time period, and level of detail needed to investigate a business question',
  },
  {
    objective: 'Evaluate an available dataset',
    evidence: 'Compare the available data with those requirements and identify concerns',
  },
  {
    objective: 'Document limitations',
    evidence:
      'Explain how missing, incomplete, or poor-quality data could affect the proposed analysis',
  },
];

const backwardRows = [
  {
    q: 'What does a successful response look like?',
    a: 'The review identifies the data the question requires, evaluates the dataset’s relevance and completeness, notes basic quality concerns, and explains how any limitations could affect the analysis.',
  },
  {
    q: 'What do learners already know?',
    a: 'Learners can recognize common parts of a dataset, including records, fields, and values.',
  },
  {
    q: 'What do learners still need to learn?',
    a: 'They need criteria for evaluating data in relation to a particular question and practice explaining why a limitation matters.',
  },
  {
    q: 'Where might they struggle?',
    a: 'Learners may focus on whether the data appears clean without noticing that essential variables, time periods, or levels of detail are missing.',
  },
  {
    q: 'How will they know they are on track?',
    a: 'A worked example, data-quality checklist, guiding questions, and explanatory feedback will help them compare their reasoning with the evaluation criteria.',
  },
];

const arc = [
  {
    n: 1,
    label: 'Frame',
    body: 'Introduce what learners will do, why it matters, and how it connects to the Module objectives.',
  },
  {
    n: 2,
    label: 'Explain',
    body: 'Introduce the essential concepts, process, or framework learners will need.',
  },
  {
    n: 3,
    label: 'Model',
    body: 'Show how an expert approaches the task, applies the process, or makes decisions. Think aloud where helpful.',
  },
  {
    n: 4,
    label: 'Practice',
    body: 'Give learners an opportunity to try part or all of the task with appropriate guidance.',
  },
  {
    n: 5,
    label: 'Give feedback',
    body: 'Help learners recognize what is working, correct misunderstandings, and decide what to try next. Feedback may include automated responses, answer explanations, worked examples, checklists, or prompts for self-review.',
  },
  {
    n: 6,
    label: 'Apply or assess',
    body: 'Ask learners to use what they have learned in a meaningful context. This may be an auto-graded assessment or an ungraded activity with clear guidance for self-checking.',
  },
];

const pathRows = [
  {
    stage: 'Frame',
    experience:
      'Encounter a scenario in which a team has customer data but is unsure whether it can answer a particular business question',
    role: 'Establishes why the quality and usefulness of data must be judged in relation to its intended purpose',
  },
  {
    stage: 'Explain',
    experience:
      'Learn how relevance, completeness, level of detail, and basic quality affect whether data can support an analysis',
    role: 'Introduces the criteria learners will use in the Data Fitness Review',
  },
  {
    stage: 'Model',
    experience:
      'Watch an expert identify what data a question requires, inspect a sample dataset, and explain their judgment aloud',
    role: 'Makes the reasoning and documentation process visible',
  },
  {
    stage: 'Practice',
    experience:
      'Use the criteria and a checklist to inspect a second dataset and draft a supported conclusion',
    role: 'Lets learners try the major parts of the final task with guidance',
  },
  {
    stage: 'Give feedback',
    experience:
      'Compare their observations with an annotated response and review explanations of concerns they may have missed',
    role: 'Helps learners check their reasoning, correct misunderstandings, and recognize what a complete evaluation includes',
  },
  {
    stage: 'Apply or assess',
    experience: 'Complete a Data Fitness Review for a new business question and dataset',
    role: 'Asks learners to demonstrate the Module objectives independently',
  },
];

const assetTable = [
  {
    asset: 'Video',
    use: 'Hear a focused explanation, see a process demonstrated, or observe expert reasoning',
  },
  {
    asset: 'Reading',
    use: 'Study detailed information, review a framework, examine graphics or code, or return to a reference while completing a task',
  },
  {
    asset: 'Interactive Plugin',
    use: 'Manipulate information, explore a model, use an external tool, or see how choices affect an outcome',
  },
  {
    asset: 'Coach Dialogue',
    use: 'Explain their reasoning, reflect, make decisions, or receive personalized guidance through an AI-supported conversation',
  },
  {
    asset: 'Coach Role Play',
    use: 'Practice interpersonal or job-related skills through a realistic interaction with an AI persona',
  },
  {
    asset: 'Assessments',
    use: 'Check understanding, practice with feedback, or demonstrate achievement of the Module objectives',
  },
  {
    asset: 'Programming Assignments',
    use: 'Write, modify, debug, or evaluate code and receive feedback on its performance',
  },
  {
    asset: 'Coursera Labs',
    use: 'Practice with code, data, software, or technical tools in a configured, in-browser environment',
  },
];

const assetQuestions = [
  'Does the learner need to read, watch, listen, interact, converse, practice, or create?',
  'Would an explanation, reusable reference, demonstration, guided practice, feedback, or opportunity to demonstrate the objective be most helpful?',
  'Would this format add meaningful value, or might another asset serve the same purpose?',
  'What instructions, preparation, or support will learners need to use the asset independently?',
  'How will the asset connect to what learners encountered before and what they will do next?',
];

const chosenAssets = [
  {
    path: 'Frame the task',
    type: 'Video',
    title: 'Start With the Business Question',
    purpose:
      'Introduces a realistic scenario and explains why data must be evaluated in relation to the question it is intended to address',
  },
  {
    path: 'Identify the data needed',
    type: 'Reading',
    title: 'From a Business Question to Data Requirements',
    purpose:
      'Helps learners identify the variables, records, time period, and level of detail a question requires',
  },
  {
    path: 'Introduce the evaluation criteria',
    type: 'Video',
    title: 'Is the Data Fit for the Question?',
    purpose:
      'Explains how relevance, completeness, and basic quality affect whether data can support an analysis',
  },
  {
    path: 'Provide a reusable reference',
    type: 'Reading',
    title: 'Data Fitness Criteria and Checklist',
    purpose:
      'Gives learners criteria and a checklist they can use during the model, practice activity, and assessment',
  },
  {
    path: 'Model the process',
    type: 'Video',
    title: 'Think Aloud: Inspecting a Sample Dataset',
    purpose: 'Shows an expert comparing a dataset with a business question and documenting concerns',
  },
  {
    path: 'Practice with support',
    type: 'Hands-on activity',
    title: 'Practice Data Fitness Review',
    purpose: 'Gives learners a second dataset to evaluate using guiding questions and the checklist',
  },
  {
    path: 'Prepare learners to communicate their judgment',
    type: 'Video',
    title: 'Documenting Data Limitations',
    purpose: 'Models how to explain why a limitation matters and how it could affect an analysis',
  },
  {
    path: 'Demonstrate the Module objectives',
    type: 'Auto-graded quiz',
    title: 'Data Fitness Review',
    purpose:
      'Presents a new business question and dataset and asks learners to identify requirements, evaluate the data, and make supported judgments',
  },
];

/* Step 5 template — the lesson plan. Titles are plain text: these are
   sample assets, so there is nothing real to link to yet. */
const lessonRows = [
  ['1', 'Identify the data the question requires', 'Video', 'Start With the Business Question'],
  [
    '2',
    'Identify the data the question requires',
    'Reading',
    'From a Business Question to Data Requirements',
  ],
  ['3', 'Evaluate whether the data is fit for purpose', 'Video', 'Is the Data Fit for the Question?'],
  [
    '4',
    'Evaluate whether the data is fit for purpose',
    'Reading',
    'Data Fitness Criteria and Checklist',
  ],
  [
    '5',
    'Evaluate whether the data is fit for purpose',
    'Video',
    'Think Aloud: Inspecting a Sample Dataset',
  ],
  [
    '6',
    'Evaluate whether the data is fit for purpose',
    'Hands-on activity',
    'Practice Data Fitness Review',
  ],
  ['7', 'Complete a Data Fitness Review', 'Video', 'Documenting Data Limitations'],
  ['8', 'Complete a Data Fitness Review', 'Auto-graded quiz', 'Data Fitness Review'],
];
---

<PageLayout
  title="Module"
  description="How to design a Coursera Module: write objectives, plan backward from the learning task, design the learning path, and choose assets."
  level="module"
>
  <div class="levelpage" data-level="module">
    <!-- Hero -->
    <div class="hero" data-cap="head">
      <div>
        <p class="eyebrow hero__eyebrow">Module</p>
        <h1 class="hero__title">Designing a Coursera Module</h1>
        <p class="hero__lead">
          A well-designed Module develops a focused part of the knowledge or skill learners need to
          achieve a Course-level objective. Define what learners should know or be able to do by the
          end of the Module, then plan the instruction, practice, feedback, and assessment that will
          help them get there.
        </p>
      </div>

      <div class="hero__rail">
        <p class="eyebrow hero__rail-eyebrow">A Module at a glance</p>
        <div class="hero__stats">
          {
            stats.map((s) => (
              <div>
                <p class="hero__stat-figure">{s.figure}</p>
                <p class="hero__stat-label">{s.label}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Step jump rail -->
    <nav class="steprail steprail--5" aria-label="Steps on this page">
      {
        steps.map((s) => (
          <a class="steprail__link" href={`#${s.id}`}>
            <span class="steprail__n">{s.n}</span>
            <span class="steprail__label">{s.label}</span>
          </a>
        ))
      }
    </nav>

    <!-- Step 1 -->
    <section class="step step--module" id="step1">
      <div class="step__head">
        <span class="step__badge" style={`--badge:${badge[0]}`}>1</span>
        <span class="step__count">Step 1 of 5</span>
      </div>
      <h2 class="step__title">Write the Module objectives</h2>
      <p class="step__p step__p--gap">
        Course objectives describe the larger skills learners should develop by the end of the
        Course. Module objectives break those skills into smaller, achievable steps.
      </p>

      <div class="askpair" data-keep>
        <div class="askpair__good">
          <p class="eyebrow askpair__eyebrow">You might ask</p>
          <p class="askpair__q">
            Which part of a larger Course objective will this Module help learners develop?
          </p>
        </div>
        <div class="askpair__weak">
          <p class="eyebrow askpair__eyebrow">Rather than asking</p>
          <p class="askpair__q">What topic should this Module cover?</p>
        </div>
      </div>

      <p class="step__p step__p--gap">
        A Module might introduce a concept, guide learners through a process, make an expert's
        reasoning visible, or give learners an opportunity to apply a skill. Write 1–3 objectives
        that describe what learners will be able to demonstrate by the end.
      </p>

      <WorkedExample
        id="wx-objectives"
        lead="Writing Module objectives for"
        name="Identifying and Evaluating Business Data"
      >
        <div class="context">
          <div class="context__row" data-depth="0">
            <span class="context__label">Specialization</span>
            <span class="context__value">Data Analytics for Business Decisions</span>
          </div>
          <div class="context__row" data-depth="1">
            <span class="context__label">Course 1</span>
            <span class="context__value">Foundations of Data Analytics for Business</span>
          </div>
          <div class="context__row" data-depth="2">
            <span class="context__label context__label--here">Module 1</span>
            <span class="context__value context__value--here"
              >Identifying and Evaluating Business Data</span
            >
          </div>
        </div>

        <p class="example__p">
          In <em>Foundations of Data Analytics for Business</em>, one Course objective is:
        </p>
        <div class="objbox objbox--plain">
          <p class="objbox__eyebrow">Course objective</p>
          <p class="objbox__text">
            By the end of this Course, learners will be able to determine whether available data is
            relevant, complete, and suitable for addressing a business question.
          </p>
        </div>

        <p class="example__p">
          The Module develops this larger capability through three focused objectives:
        </p>
        <div class="objbox objbox--accent">
          <p class="objbox__eyebrow objbox__eyebrow--accent">Module objectives</p>
          <p class="objbox__text objbox__text--stem">
            By the end of this Module, learners will be able to:
          </p>
          <ul class="bullets bullets--accent">
            {moduleObjectives.map((o) => <li>{o}</li>)}
          </ul>
        </div>

        <p class="example__p">
          These objectives give the Module a clear destination. Learners are not simply being
          introduced to “data quality.” They are learning to make and explain a practical judgment
          about whether data is fit for a particular purpose.
        </p>
      </WorkedExample>
    </section>

    <!-- Step 2 -->
    <section class="step step--module" id="step2">
      <div class="step__head">
        <span class="step__badge" style={`--badge:${badge[1]}`}>2</span>
        <span class="step__count">Step 2 of 5</span>
      </div>
      <h2 class="step__title">Plan backward from the learning task</h2>
      <p class="step__p">
        Once the Module objectives are clear, design the Module around how learners will show what
        they have learned.
      </p>
      <p class="step__p step__p--strong">What will learners do to show what they’ve learned?</p>
      <p class="step__p step__p--gap">
        Start with the task learners should be able to complete by the end of the Module. Then work
        backward to identify what they already know, what they still need to learn, and what practice
        and feedback will help them succeed.
      </p>

      <p class="step__p step__p--tight">Use these questions to clarify the learning path:</p>
      <div class="arclist" data-keep>
        {
          planningQuestions.map((q) => (
            <div class="arclist__row arclist__row--stacked">
              <span class="arclist__n">{q.n}</span>
              <div class="arclist__stack">
                <p class="arclist__label">{q.title}</p>
                <p class="arclist__body">{q.body}</p>
              </div>
            </div>
          ))
        }
      </div>

      <WorkedExample
        id="wx-task"
        lead="Turning Module objectives into"
        name="a learning task"
      >
        <p class="example__p">
          In <em>Identifying and Evaluating Business Data</em>, learners are working toward three
          Module objectives:
        </p>
        <ul class="bullets bullets--accent bullets--gap">
          {moduleObjectives.map((o) => <li>{o}</li>)}
        </ul>

        <p class="example__p">
          To plan the final task, consider what learners would need to do to provide evidence of each
          objective:
        </p>

        <div class="dtable dtable--evidence">
          <div class="dtable__head">
            <div class="dtable__cell">Module objective</div>
            <div class="dtable__cell">Evidence of learning</div>
          </div>
          {
            evidenceRows.map((r) => (
              <div class="dtable__row">
                <div class="dtable__cell dtable__cell--key">{r.objective}</div>
                <div class="dtable__cell">{r.evidence}</div>
              </div>
            ))
          }
        </div>

        <p class="example__p example__p--top">
          These actions can be brought together in one meaningful task. Learners could receive a
          business question and an unfamiliar dataset, inspect the data in relation to the question,
          and document whether the dataset is fit for the proposed analysis.
        </p>
        <p class="example__p">
          For this Module, we will call that task a <strong>Data Fitness Review</strong>.
        </p>

        <div class="objbox objbox--accent">
          <p class="objbox__eyebrow objbox__eyebrow--accent">The final task</p>
          <p class="objbox__text">
            Complete a Data Fitness Review that evaluates whether an available dataset is suitable
            for addressing a business question and documents concerns that could affect the proposed
            analysis.
          </p>
        </div>

        <p class="example__p">Now work backward from that task:</p>

        <div class="dtable dtable--backward">
          <div class="dtable__head">
            <div class="dtable__cell">Planning question</div>
            <div class="dtable__cell">Decision for this Module</div>
          </div>
          {
            backwardRows.map((r) => (
              <div class="dtable__row">
                <div class="dtable__cell dtable__cell--key">{r.q}</div>
                <div class="dtable__cell">{r.a}</div>
              </div>
            ))
          }
        </div>

        <p class="example__p example__p--top">
          These decisions establish what the Module must prepare learners to do. The next step is to
          arrange the necessary explanation, modeling, practice, and feedback into a coherent learning
          path.
        </p>
      </WorkedExample>
    </section>

    <!-- Step 3 -->
    <section class="step step--module" id="step3">
      <div class="step__head">
        <span class="step__badge" style={`--badge:${badge[2]}`}>3</span>
        <span class="step__count">Step 3 of 5</span>
      </div>
      <h2 class="step__title">Design the learning path</h2>
      <p class="step__p">
        Modules do not need to follow one fixed structure. Some topics require more explanation,
        while others benefit from repeated practice, multiple examples, or opportunities to make and
        correct mistakes.
      </p>
      <p class="step__p step__p--tight">
        Many effective Modules include some version of this learning arc:
      </p>

      <div class="arclist" data-keep>
        {
          arc.map((a) => (
            <div class="arclist__row">
              <span class="arclist__n">{a.n}</span>
              <span class="arclist__label">{a.label}</span>
              <span class="arclist__body">{a.body}</span>
            </div>
          ))
        }
      </div>

      <p class="step__p step__p--gap">
        These stages may repeat or overlap. For example, learners may move through explanation,
        modeling, practice, and feedback several times before completing the final task.
      </p>

      <WorkedExample
        id="wx-path"
        lead="Mapping and supporting"
        name="the learning path"
      >
        <p class="example__p">
          The backward-planning process established that learners will complete a <strong
            >Data Fitness Review</strong
          >. To succeed, they will need to identify the data a business question requires, evaluate an
          available dataset against those requirements, and explain how its limitations could affect
          an analysis.
        </p>
        <p class="example__p example__p--gap">
          The learning path prepares learners for each part of that task:
        </p>

        <div class="dtable dtable--path">
          <div class="dtable__head">
            <div class="dtable__cell">Stage</div>
            <div class="dtable__cell">Learner experience</div>
            <div class="dtable__cell">Role in the learning path</div>
          </div>
          {
            pathRows.map((r) => (
              <div class="dtable__row">
                <div class="dtable__cell dtable__cell--key">{r.stage}</div>
                <div class="dtable__cell">{r.experience}</div>
                <div class="dtable__cell">{r.role}</div>
              </div>
            ))
          }
        </div>

        <p class="example__p example__p--top">
          Each stage prepares learners for something the final task requires. The explanation
          introduces the evaluation criteria, the model shows how to apply and document them, the
          practice lets learners try the process with support, and the feedback helps them refine
          their judgment before working independently.
        </p>
        <p class="example__p">
          The path may still move among explanation, modeling, practice, and feedback more than once.
          What matters is that learners receive the preparation they need before being asked to
          complete the Data Fitness Review on their own.
        </p>
      </WorkedExample>
    </section>

    <!-- Step 4 -->
    <section class="step step--module" id="step4">
      <div class="step__head">
        <span class="step__badge" style={`--badge:${badge[3]}`}>4</span>
        <span class="step__count">Step 4 of 5</span>
      </div>
      <h2 class="step__title">Choose Learning Assets intentionally</h2>
      <p class="step__p">
        After mapping the learning path, consider what learners may need at each stage. Then choose
        the Coursera Learning Asset that best supports that part of the experience.
      </p>
      <p class="step__p">
        Begin with the learner’s experience rather than the format. A worked example, for instance,
        is an instructional strategy that might be delivered through a video or a reading. Practice
        might take place through an ungraded assessment, Coach Role Play, a programming assignment,
        an interactive plugin, or a Coursera Lab.
      </p>
      <p class="step__p step__p--gap">
        The same asset can serve different purposes. A video might explain a concept, demonstrate a
        process, or make expert reasoning visible. What matters is how the asset helps learners
        progress toward the Module objectives.
      </p>

      <h3 class="h3">Learning Assets available in Coursera</h3>
      <div class="dtable dtable--assets" data-keep>
        <div class="dtable__head">
          <div class="dtable__cell">Coursera asset</div>
          <div class="dtable__cell">Especially useful when learners need to…</div>
        </div>
        {
          assetTable.map((a) => (
            <div class="dtable__row">
              <div class="dtable__cell dtable__cell--asset">{a.asset}</div>
              <div class="dtable__cell">{a.use}</div>
            </div>
          ))
        }
      </div>

      <div class="note-gold note-gold--gap" data-keep>
        <p class="note-gold__text note-gold__text--only">
          Each Module must include at least one graded Assessment. Ungraded Assessments are also
          encouraged as opportunities for learners to practice, check their understanding, and
          receive feedback before graded work.
        </p>
      </div>

      <h3 class="h3">Choose a Learning Asset that fits the learning need</h3>
      <p class="step__p step__p--tight">As you consider the options, ask:</p>
      <ul class="qlist">
        {assetQuestions.map((q) => <li>{q}</li>)}
      </ul>

      <div class="askpair" data-keep>
        <div class="askpair__good">
          <p class="eyebrow askpair__eyebrow">You might ask</p>
          <p class="askpair__q">
            What does the learner need to do next, and which Coursera Learning Asset might support
            that need most effectively?
          </p>
        </div>
        <div class="askpair__weak">
          <p class="eyebrow askpair__eyebrow">Rather than asking</p>
          <p class="askpair__q">How many videos and readings should this Module contain?</p>
        </div>
      </div>

      <WorkedExample
        id="wx-assets"
        lead="Choosing Learning Assets to"
        name="support your Module objectives"
      >
        <p class="example__p">
          The learning path for <strong>Module 1: Identifying and Evaluating Business Data</strong>
          establishes what learners need to experience: an introduction to the evaluation criteria, a
          model of expert reasoning, supported practice with feedback, and an opportunity to complete
          the Data Fitness Review independently.
        </p>
        <p class="example__p example__p--gap">
          The next step is to organize those experiences into Lessons and select the Coursera Learning
          Assets that will support them.
        </p>

        <div class="dtable dtable--chosen">
          <div class="dtable__head">
            <div class="dtable__cell">Learning path</div>
            <div class="dtable__cell">Learning Assets</div>
            <div class="dtable__cell">Learning purpose</div>
          </div>
          {
            chosenAssets.map((c) => (
              <div class="dtable__row">
                <div class="dtable__cell dtable__cell--key">{c.path}</div>
                <div class="dtable__cell">
                  <p class="chosen__type">{c.type}</p>
                  <p class="chosen__title">{c.title}</p>
                </div>
                <div class="dtable__cell">{c.purpose}</div>
              </div>
            ))
          }
        </div>

        <p class="example__p example__p--top">
          These assets can be organized into a smaller number of Lessons. A Lesson is not a single
          asset; it is a purposeful segment of the learning path that may bring several assets
          together.
        </p>
        <p class="example__p example__p--tight">For example:</p>
        <ul class="plainlist">
          <li>
            <strong>Lesson 1: Identify the data the question requires</strong> includes a Video and a
            Reading.
          </li>
          <li>
            <strong>Lesson 2: Evaluate whether the data is fit for purpose</strong> includes two
            Videos, a Reading, and a hands-on activity.
          </li>
          <li>
            <strong>Lesson 3: Complete a Data Fitness Review</strong> includes a Video and the
            auto-graded quiz.
          </li>
        </ul>
        <p class="example__p">
          The Module meets Coursera’s asset expectations while keeping every selection connected to
          the learning path. The goal is not to minimize the number of assets, but to avoid adding
          assets that do not help learners progress toward the final task.
        </p>
      </WorkedExample>
    </section>

    <!-- Step 5: template -->
    <section class="step step--module step--last" id="step5">
      <div class="step__head">
        <span class="step__badge" style={`--badge:${badge[4]}`}>5</span>
        <span class="step__count">Step 5 of 5</span>
      </div>
      <h2 class="step__title">Complete your Module plan</h2>
      <p class="step__q">
        Use this page to work through the course-design decisions, then record them in the Design
        Document. The sample below shows how those decisions might come together for <strong
          >Module 1: Identifying and Evaluating Business Data</strong
        > from <strong>Course 1: Foundations of Data Analytics</strong> in the example <strong
          >Specialization: <span class="nostyle">Data Analytics for Business Decisions</span></strong
        >. Use it as a reference as you develop your own plan.
      </p>

      <div class="tmpl">
        <div class="tmpl__bar">
          <span class="tmpl__bar-title">Course 1 · Module 1</span>
          <span class="tmpl__bar-note">Repeats per module</span>
        </div>

        <div class="tmpl__field">
          <div class="tmpl__labelrow">
            <p class="tmpl__label">Module title</p>
            <BestPractice title="Module title">
              <p>
                Give the Module a <strong>clear, focused purpose within the Course</strong>. A strong
                title signals what learners will learn, do, or produce—not simply where the Module
                appears in the sequence. Favor descriptive titles over labels such as <em
                  >Module 2</em
                > or <em>Introduction to…</em>
              </p>
            </BestPractice>
          </div>
          <p class="tmpl__help">Draft what learners will learn, do, or produce in this Module.</p>
          <div class="tmpl__value"><p>Identifying and Evaluating Business Data</p></div>
        </div>

        <div class="tmpl__field">
          <div class="tmpl__labelrow">
            <p class="tmpl__label">Module description</p>
            <BestPractice title="Module description">
              <p>
                Orient learners to <strong>what they will accomplish and why it matters</strong>.
                Keep the description learner-facing and focused on the Module’s purpose rather than
                listing every topic or learning asset.
              </p>
            </BestPractice>
          </div>
          <p class="tmpl__help">
            Draft a learner-friendly 2-3 sentence summary of the Module content and learning
            outcomes.
          </p>
          <div class="tmpl__value">
            <p>
              Learn how to determine whether available data can address a business question. You will
              identify the data a question requires, evaluate a sample dataset for relevance,
              completeness, and quality concerns, and document limitations that could affect an
              analysis.
            </p>
          </div>
        </div>

        <div class="tmpl__field">
          <div class="tmpl__labelrow">
            <p class="tmpl__label">Module learning objectives</p>
            <BestPractice title="Module learning objectives">
              <p>
                Break the larger Course objectives into <strong
                  >1–3 smaller learning goals learners can reasonably achieve within this Module</strong
                >. Each objective should describe something learners can demonstrate and help guide
                the practice and assessment you design.
              </p>
              <p>
                Begin with observable verbs such as <strong
                  >identify, calculate, apply, analyze, interpret, evaluate, create,</strong
                > or <strong>recommend</strong>.
              </p>
            </BestPractice>
          </div>
          <p class="tmpl__help">
            Write 1-3 actionable, measurable learning objectives that describe what learners will be
            able to do by the end of the Module.
          </p>
          <div class="tmpl__value">
            <ol>
              {moduleObjectives.map((o) => <li>{o}</li>)}
            </ol>
          </div>
        </div>

        <div class="tmpl__row">
          <div class="tmpl__field">
            <div class="tmpl__labelrow">
              <p class="tmpl__label">Estimated learning time</p>
              <BestPractice title="Estimated learning time">
                <p>
                  Estimate the <strong>complete learner experience</strong>, including videos,
                  readings, activities, practice, and the graded assessment—not just the time spent
                  viewing instructional content. Keep the Module focused enough to feel like a
                  manageable step in a self-paced Course.
                </p>
              </BestPractice>
            </div>
            <div class="tmpl__value"><p>Approximately 45 minutes</p></div>
          </div>
          <div class="tmpl__field">
            <div class="tmpl__labelrow">
              <p class="tmpl__label">Graded assessment title</p>
              <BestPractice title="Graded assessment title" align="right">
                <p>
                  Use a learner-facing title that reflects the <strong
                    >learning being demonstrated</strong
                  >, rather than a generic label such as <em>Module 2 Quiz</em>. The assessment title
                  should help learners understand what they are about to do.
                </p>
              </BestPractice>
            </div>
            <div class="tmpl__value"><p>Data Fitness Review</p></div>
          </div>
        </div>

        <!-- This subsection switches to gold because it concerns learning assets. -->
        <div class="tmpl__field tmpl__field--gold" data-keep>
          <p class="tmpl__label tmpl__label--gold">Lessons &amp; Learning Assets</p>
          <p class="tmpl__help">
            For anything created outside this template, please include a link to the final or draft
            source. This will help your Learning Experience Designer build the content directly from
            the source. Lessons are optional, so you may leave this column blank or remove it if
            you're not using lessons.
          </p>
          <p class="tmpl__aim">
            Aim for a minimum of: 3–6 videos · 1–2 readings · 1–2 activities · 1 auto-graded quiz
          </p>

          <div class="dtable dtable--lessons">
            <div class="dtable__head dtable__head--gold">
              <div class="dtable__cell">#</div>
              <div class="dtable__cell">
                <span class="dtable__label">Lesson (optional)</span>
                <BestPractice title="Lesson (optional)" tone="gold" size="sm">
                  <p>
                    Use Lessons when they help organize several learning assets around a <strong
                      >meaningful subtopic, task, or stage of learning</strong
                    >. A Lesson should make the Module easier to navigate—not add another layer of
                    structure simply for its own sake.
                  </p>
                  <p>
                    Short Modules may not need Lessons at all. Learning assets can appear directly in
                    the Module when that creates a clearer experience for learners.
                  </p>
                </BestPractice>
              </div>
              <div class="dtable__cell">
                <span class="dtable__label">Asset type</span>
                <BestPractice title="Asset type" tone="gold" size="sm" width={440}>
                  <p>
                    Choose the learning asset based on <strong
                      >what learners need to do at that point in the learning experience</strong
                    >, rather than defaulting to video.
                  </p>
                  <p>Different formats support different purposes:</p>
                  <ul class="bp__list">
                    <li>Explain or demonstrate → Video</li>
                    <li>Provide reference or step-by-step guidance → Reading</li>
                    <li>Connect learning to experience or reason through a case → Dialogue</li>
                    <li>Try a skill directly → Hands-on Practice, Lab, or interactive activity</li>
                    <li>Check understanding and receive feedback → Practice Quiz</li>
                    <li>Demonstrate achievement → Graded Assessment</li>
                  </ul>
                  <p>When appropriate, aim for a rhythm of:</p>
                  <p class="bp__rhythm">Learn → Try → Receive feedback → Apply</p>
                  <p>
                    This often gives learners more opportunities to use what they are learning than
                    placing all instruction first and all assessment at the end.
                  </p>
                </BestPractice>
              </div>
              <div class="dtable__cell">
                <span class="dtable__label">Asset title</span>
                <BestPractice title="Asset title" tone="gold" size="sm" align="right" width={440}>
                  <p>
                    Use <strong>specific, learner-facing titles</strong> that tell learners what they
                    are about to learn or do. Avoid production labels such as <em>Video 2</em>, <em
                      >Reading 1</em
                    >, or <em>Activity</em>. Clear titles also make the learning path easier to scan
                    in a self-paced Course.
                  </p>
                  <p>
                    <strong>Linking the source.</strong> Link to the <strong
                      >most current source material your Learning Experience Designer should use to
                      build the asset</strong
                    >. Make sure the source is accessible to the project team, and indicate whether it
                    is draft, under review, or final when useful.
                  </p>
                  <p>
                    Whenever possible, link to editable source material rather than a copy created
                    only for review.
                  </p>
                </BestPractice>
              </div>
            </div>
            {
              lessonRows.map((r) => (
                <div class="dtable__row">
                  <div class="dtable__cell">{r[0]}</div>
                  <div class="dtable__cell">{r[1]}</div>
                  <div class="dtable__cell dtable__cell--type">{r[2]}</div>
                  <div class="dtable__cell dtable__cell--title">{r[3]}</div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="tmpl__field">
          <div class="tmpl__labelrow">
            <p class="tmpl__label">
              Additional build notes, dependencies, or accessibility information
            </p>
            <BestPractice title="Additional build notes, dependencies, or accessibility information">
              <p>
                Use this space for information the Learning Experience Designer needs that <strong
                  >isn’t clear from the source material itself</strong
                >. Note required sequencing, dependencies between assets, setup needs, accessibility
                considerations, external tools, or special build behavior.
              </p>
              <p>
                For a self-paced Course, pay particular attention to anything learners may need in
                order to complete the experience without live instructor support. Consider whether
                learners will know what to do, what materials or tools they need, and how they can
                check their progress.
              </p>
            </BestPractice>
          </div>
          <div class="tmpl__value">
            <p>
              Customer dataset supplied as a spreadsheet. No specialized software required. Checklist
              needs a screen-reader-friendly version.
            </p>
          </div>
        </div>

        <div class="tmpl__cta">
          <div class="tmpl__labelrow">
            <p class="tmpl__label">Course 1 · Module 1 Graded Quiz</p>
            <BestPractice title="Graded quiz">
              <p>
                Build the quiz around the <strong>Module objectives</strong>, rather than testing
                isolated facts from videos or readings. When the objective calls for application,
                interpretation, or decision-making, design questions that ask learners to apply,
                interpret, distinguish, or decide.
              </p>
              <p>
                Provide useful feedback for <strong>both correct and incorrect responses</strong>.
                Feedback can explain why an answer works, clarify a misconception, or point learners
                toward what they may want to review.
              </p>
              <p>
                Use the <strong>Graded Quiz Import Template in your Design Document</strong> when
                drafting quiz questions. Working in the template helps organize questions, answer
                options, correct answers, and feedback in a format that supports the Coursera build.
              </p>
            </BestPractice>
          </div>
          <p class="tmpl__help">
            Before writing your questions, please review the Coursera Graded Quiz Template and
            Guidelines. The quiz should assess the objectives for this module.
          </p>
          <a class="btn btn--gold" href="#" data-template-link>Open the template in Google Docs ↗</a>
        </div>
      </div>
    </section>
  </div>
</PageLayout>

