---
import PageLayout from '../layouts/PageLayout.astro';
import WorkedExample from '../components/WorkedExample.astro';
import BestPractice from '../components/BestPractice.astro';

const stats = [
  { figure: '3–6 courses', label: 'the whole program' },
  { figure: '8–48 hours', label: 'total learner time' },
  { figure: '1+ project per course', label: 'hands-on, real-world' },
  { figure: 'Specialization Certificate', label: 'on completing every course' },
];

const steps = [
  { id: 'step1', n: 1, label: 'Define the goal' },
  { id: 'step2', n: 2, label: 'Shape the journey' },
  { id: 'step3', n: 3, label: 'Complete the plan' },
];

const ideas = [
  {
    title: 'Make the value clear.',
    body: 'Help learners quickly understand who the Specialization is for, what it will help them accomplish, and why that matters.',
  },
  {
    title: 'Connect learning to practical goals.',
    body: 'Focus on skills and knowledge learners can use in a professional, academic, or other real-world context.',
  },
  {
    title: 'Respect the learner’s time.',
    body: 'Prioritize what is essential and design toward a focused, achievable outcome.',
  },
];

const courses = [
  {
    n: 1,
    title: 'Foundations of Data Analytics for Business',
    body: 'Learners begin by translating a business need into a question that can be investigated with data. They identify the data they need, evaluate its basic quality, and prepare it for analysis.',
    leave: 'a focused business question and an analysis-ready dataset.',
    hours: '7 hours',
    outcome: 'A focused business question and an analysis-ready dataset',
  },
  {
    n: 2,
    title: 'Analyzing and Visualizing Business Data',
    body: 'Learners use appropriate analytical methods to investigate their question. They interpret the results and create visualizations that make important patterns and findings easier to understand.',
    leave: 'analytical findings and supporting visualizations.',
    hours: '9 hours',
    outcome: 'Analytical findings and supporting visualizations',
  },
  {
    n: 3,
    title: 'Communicating Data-Driven Recommendations',
    body: 'Learners determine what conclusions the evidence supports, account for limitations or uncertainty, and communicate a recommendation to a relevant audience.',
    leave: 'a clear, evidence-informed recommendation.',
    hours: '8 hours',
    outcome: 'A clear, evidence-informed recommendation',
  },
];

const skills = [
  'Data Cleaning',
  'Exploratory Data Analysis',
  'Data Visualization',
  'Spreadsheet Analysis',
  'Business Intelligence',
  'Data Storytelling',
  'Evidence-Based Decision-Making',
];

const objectives = [
  'Frame a business question that can be investigated with data.',
  'Analyze and visualize relevant data to identify meaningful findings.',
  'Communicate an evidence-informed recommendation to a business audience.',
];
---

<PageLayout
  title="Specialization"
  description="How to design a Coursera Specialization: define the goal, shape the journey, and complete the plan."
  level="specialization"
>
  <div class="levelpage" data-level="specialization">
    <!-- Hero -->
    <div class="hero" data-cap="head">
      <div>
        <p class="eyebrow hero__eyebrow">Specialization</p>
        <h1 class="hero__title">Designing a Coursera Specialization</h1>
        <p class="hero__lead">
          When exploring a Specialization, learners are often asking: Is this for me? What will I be
          able to do? And how will this learning support my goals?
        </p>
        <p class="hero__lead">
          Use these questions to guide the design. Identify your audience, the goals they are working
          toward, and what they should know and be able to do by the end of the Specialization. Then
          shape the sequence of Courses to create a clear path and show how each Course contributes to
          learners’ progress.
        </p>
      </div>

      <div class="hero__rail">
        <p class="eyebrow hero__rail-eyebrow">A Specialization at a glance</p>
        <div class="hero__stats">
          {
            stats.map((s) => (
              <div>
                <p class="hero__stat-figure">{s.figure}</p>
                <p class="hero__stat-label">{s.label}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Step jump rail -->
    <nav class="steprail steprail--3" aria-label="Steps on this page">
      {
        steps.map((s) => (
          <a class="steprail__link" href={`#${s.id}`}>
            <span class="steprail__n">{s.n}</span>
            <span class="steprail__label">{s.label}</span>
          </a>
        ))
      }
    </nav>

    <!-- Step 1 -->
    <section class="step" id="step1">
      <div class="step__head">
        <span class="step__badge">1</span>
        <span class="step__count">Step 1 of 3</span>
      </div>
      <h2 class="step__title">Define the goal</h2>
      <p class="step__q">
        What should learners be able to do by the end of this Specialization?
      </p>
      <p class="step__p">
        A strong Specialization begins with a clear understanding of the learners you hope to serve
        and what they want to accomplish. Before planning individual Courses, take some time to
        consider who the experience is for, what goals they are working toward, and what they should
        be able to do by the end.
      </p>
      <p class="step__p">
        Coursera learners are often looking for learning that feels relevant, useful, and manageable
        alongside their other responsibilities. As you design, help them see how the Specialization
        connects to their goals and how the time they invest will support their progress.
      </p>

      <p class="eyebrow ideas__eyebrow">A few ideas to keep in mind</p>
      <div class="ideas">
        {
          ideas.map((i) => (
            <div class="ideas__item" data-keep>
              <p class="ideas__title">{i.title}</p>
              <p class="ideas__body">{i.body}</p>
            </div>
          ))
        }
      </div>

      <WorkedExample id="wx-goal" lead="Defining the goal for" name="Data Analytics for Business Decisions">
        <p class="example__p">
          Suppose you are designing a Specialization on <em>Data Analytics for Business Decisions</em
          >. It may be tempting to begin with a list of topics or tools to cover. Instead, begin with
          the learner and a practical need.
        </p>
        <p class="example__p">
          This Specialization is intended for professionals who use data or make decisions informed
          by data but may not have formal training in analytics. They want to become more confident
          asking useful questions, interpreting evidence, and recommending a course of action.
        </p>
        <p class="example__p">That learner need leads to a focused end goal:</p>

        <div class="goalbox">
          <p class="goalbox__eyebrow">The goal</p>
          <p class="goalbox__body">
            By the end of the Specialization, learners will be able to frame a business question,
            analyze and visualize relevant data, and communicate an evidence-informed
            recommendation.
          </p>
        </div>

        <p class="example__p">
          This is more useful than a broad goal such as “understand the fundamentals of data
          analytics.” It describes what learners will be able to do, connects the learning to a
          recognizable need, and provides a practical boundary for deciding what belongs in the
          Specialization.
        </p>
      </WorkedExample>
    </section>

    <!-- Step 2 -->
    <section class="step" id="step2">
      <div class="step__head">
        <span class="step__badge">2</span>
        <span class="step__count">Step 2 of 3</span>
      </div>
      <h2 class="step__title">Shape the journey</h2>
      <p class="step__q">
        How should the Courses work together to help learners reach that goal?
      </p>
      <p class="step__p">
        Courses may introduce, develop, integrate, or apply different skills. Some Specializations
        work best as a clear progression in which each Course builds on the one before it. Others may
        include Courses that are more modular and useful on their own.
      </p>
      <p class="step__p step__p--gap">
        There is no single required structure. What matters is that each Course has a distinct
        purpose and that the relationship among the Courses is intentional and easy for learners to
        understand.
      </p>

      <div class="askpair" data-keep>
        <div class="askpair__good">
          <p class="eyebrow askpair__eyebrow">You might ask</p>
          <p class="askpair__q">What should each Course contribute to the larger learner journey?</p>
        </div>
        <div class="askpair__weak">
          <p class="eyebrow askpair__eyebrow">Rather than asking</p>
          <p class="askpair__q">How should I divide my content into three Courses?</p>
        </div>
      </div>

      <WorkedExample
        id="wx-journey"
        lead="Shaping the journey for"
        name="Data Analytics for Business Decisions"
      >
        <p class="example__p">
          Once the overall goal is clear, consider what learners need to accomplish at each stage of
          the journey.
        </p>
        <p class="example__p">
          Rather than dividing data analytics content into three roughly equal groups of topics, give
          each Course a distinct role in helping learners move toward the Specialization goal.
        </p>

        <div class="journey">
          <div class="journey__head">
            <span class="journey__title">Data Analytics for Business Decisions</span>
            <span class="journey__kind">Specialization</span>
          </div>
          {
            courses.map((c) => (
              <div class="journey__course">
                <div class="journey__course-head">
                  <span class="journey__n">{c.n}</span>
                  <p class="journey__course-title">{c.title}</p>
                </div>
                <p class="journey__body">{c.body}</p>
                <p class="journey__leave">
                  <strong>Learners leave with:</strong> {c.leave}
                </p>
              </div>
            ))
          }
        </div>

        <p class="example__p">Together, the Courses create a recognizable progression:</p>
        <div class="arc">
          <span class="arc__step">Frame and prepare</span>
          <span class="arc__arrow" aria-hidden="true">→</span>
          <span class="arc__step">Analyze and visualize</span>
          <span class="arc__arrow" aria-hidden="true">→</span>
          <span class="arc__step">Recommend and communicate</span>
        </div>
      </WorkedExample>
    </section>

    <!-- Step 3: template -->
    <section class="step step--last" id="step3">
      <div class="step__head">
        <span class="step__badge">3</span>
        <span class="step__count">Step 3 of 3</span>
      </div>
      <h2 class="step__title">Complete your Specialization plan</h2>
      <p class="step__q">
        Use this page to work through the course-design decisions, then record them in the Design
        Document. The sample below shows how those decisions might come together for the example
        <strong>Specialization: <span class="nostyle">Data Analytics for Business Decisions</span></strong
        >. Use it as a reference as you develop your own plan.
      </p>

      <div class="tmpl">
        <div class="tmpl__bar">
          <span class="tmpl__bar-title">Specialization Landing Page</span>
          <span class="tmpl__bar-note">Complete once</span>
        </div>

        <div class="tmpl__link-row">
          <a
            class="ext"
            href="https://www.coursera.org/search?query=duke%20university"
            target="_blank"
            rel="noopener">See a sample Specialization Landing Page ↗</a
          > on Coursera
        </div>

        <div class="tmpl__field">
          <div class="tmpl__labelrow">
            <p class="tmpl__label">Specialization title</p>
            <BestPractice title="Specialization title">
              <p>
                Write for the learner deciding whether to click. A strong title makes the <strong
                  >topic and value of the Specialization immediately clear</strong
                >. Favor specific, familiar language over academic or internally meaningful
                terminology.
              </p>
            </BestPractice>
          </div>
          <div class="tmpl__value"><p>Data Analytics for Business Decisions</p></div>
        </div>

        <div class="tmpl__field">
          <div class="tmpl__labelrow">
            <p class="tmpl__label">About this Specialization</p>
            <BestPractice title="About this Specialization">
              <p>
                Lead with what learners will <strong>gain or be able to do</strong>, rather than with
                a list of topics. Help learners quickly understand who the Specialization is for,
                what they will experience, and why it is worth their time.
              </p>
            </BestPractice>
          </div>
          <div class="tmpl__value">
            <p>
              Designed for professionals, students, and career changers who want to use data more
              effectively in business settings, this beginner-level Specialization introduces the
              process of turning business needs into focused questions, analyzing relevant data, and
              communicating evidence-informed recommendations. Across three courses, learners will
              frame business questions, identify and prepare data, analyze and visualize findings,
              and develop recommendations for a business audience. Learners will build skills in
              business problem framing, data requirements analysis, data cleaning, spreadsheet
              analysis, exploratory data analysis, data visualization, and data storytelling.
              Assessments include quizzes, guided practice, applied assignments, and a culminating
              project using a realistic business scenario and dataset.
            </p>
            <p>
              The series is designed for learners who may work with data or make data-informed
              decisions but do not have formal training in analytics. It offers a practical,
              end-to-end learning experience focused on the kinds of tasks professionals commonly
              encounter at work. Learners will leave with a portfolio-ready project, a foundation for
              further study, and a shareable Coursera certificate.
            </p>
            <p>
              Led by Jordan Lee, a faculty member specializing in business analytics and
              evidence-informed decision-making, the Specialization emphasizes the connection between
              business context, analytical methods, and clear communication. This is an increasingly
              important capability as organizations rely on data to guide decisions.
            </p>
          </div>
        </div>

        <div class="tmpl__field">
          <div class="tmpl__labelrow">
            <p class="tmpl__label">Projects overview</p>
            <BestPractice title="Projects overview">
              <p>
                Describe what learners will <strong>make, analyze, evaluate, or solve</strong>.
                Projects should reflect realistic situations learners may encounter beyond the course
                — not simply serve as longer versions of quizzes.
              </p>
            </BestPractice>
          </div>
          <div class="tmpl__value">
            <p>
              In the culminating project, learners investigate an authentic business question using a
              realistic dataset, prepare and analyze the data, create visualizations to communicate
              key findings, and develop an evidence-informed recommendation for a business audience.
              The project brings together common workplace tasks such as evaluating customer
              behavior, monitoring performance, or identifying opportunities for improvement.
            </p>
          </div>
        </div>

        <div class="tmpl__row">
          <div class="tmpl__field">
            <div class="tmpl__labelrow">
              <p class="tmpl__label">Who this is for</p>
              <BestPractice title="Who this is for">
                <p>
                  Describe learners in terms they are likely to recognize: their <strong
                    >role, goals, or reasons for learning</strong
                  >. Be specific enough to help the right learners identify themselves, while
                  avoiding requirements that unnecessarily exclude interested learners.
                </p>
              </BestPractice>
            </div>
            <div class="tmpl__value">
              <p>
                Professionals who work with data or make decisions informed by data but may not have
                formal training in analytics; students and career changers seeking a practical
                introduction to business analytics; and managers or team members who want to
                communicate more effectively with data professionals.
              </p>
            </div>
          </div>
          <div class="tmpl__field">
            <div class="tmpl__labelrow">
              <p class="tmpl__label">Recommended background</p>
              <BestPractice title="Recommended background" align="right">
                <p>
                  Include only the knowledge or experience learners <strong
                    >actually need to succeed</strong
                  >. Distinguish essential preparation from helpful context so that ideal
                  qualifications do not become unnecessary barriers to enrollment.
                </p>
              </BestPractice>
            </div>
            <div class="tmpl__value">
              <p>
                No prior experience in data analytics or programming. Familiarity with basic
                workplace math is helpful.
              </p>
            </div>
          </div>
        </div>

        <div class="tmpl__field">
          <div class="tmpl__labelrow">
            <p class="tmpl__label">What will you learn</p>
            <BestPractice title="What will you learn">
              <p>
                Describe <strong>observable capabilities</strong>, not topics learners will encounter
                or ideas they will “understand.” Begin with an action verb such as <strong
                  >evaluate, apply, analyze, design,</strong
                > or <strong>recommend</strong>, and make sure the objectives represent the <strong
                  >full Specialization</strong
                >, not just one course.
              </p>
            </BestPractice>
          </div>
          <div class="tmpl__value">
            <ol>
              {objectives.map((o) => <li>{o}</li>)}
            </ol>
          </div>
        </div>

        <div class="tmpl__field">
          <div class="tmpl__labelrow">
            <p class="tmpl__label">Skills learners will gain</p>
            <BestPractice title="Skills learners will gain">
              <p>
                Name <strong>specific, recognizable skills learners can demonstrate</strong>, rather
                than broad subject areas. Choose terms learners might use to describe their
                capabilities on a résumé, on LinkedIn, or in a conversation with an employer.
              </p>
            </BestPractice>
          </div>
          <div class="tmpl__chips">
            {skills.map((s) => <span class="tmpl__chip">{s}</span>)}
          </div>
        </div>

        <div class="tmpl__row">
          <div class="tmpl__field">
            <div class="tmpl__labelrow">
              <p class="tmpl__label">Estimated total learning time</p>
              <BestPractice title="Estimated total learning time">
                <p>
                  Estimate the learner's <strong>total experience</strong>, not just the length of
                  the instructional content. Include time for watching, reading, practicing,
                  completing projects, and taking assessments. Account for the reality that Coursera
                  learners often study in shorter sessions around other responsibilities.
                </p>
              </BestPractice>
            </div>
            <div class="tmpl__value"><p>Approximately 24 hours</p></div>
          </div>
          <div class="tmpl__field">
            <div class="tmpl__labelrow">
              <p class="tmpl__label">Difficulty level</p>
              <BestPractice title="Difficulty level" align="right">
                <p>
                  Choose the level based on the <strong
                    >knowledge, skills, and independence required of the learner</strong
                  >, not on the sophistication of the subject itself. A complex topic can still be
                  appropriate for beginners when concepts are introduced from the ground up.
                </p>
              </BestPractice>
            </div>
            <div class="tmpl__value"><p>Beginner</p></div>
          </div>
        </div>

        <div class="tmpl__field">
          <div class="tmpl__labelrow">
            <p class="tmpl__label">Tools, technology, or platforms</p>
            <BestPractice title="Tools, technology, or platforms">
              <p>
                Identify anything learners need to <strong
                  >access or use to complete the learning experience</strong
                >, including external tools, software, accounts, or platforms. Make requirements
                visible early, and flag any paid licenses or institutional access requirements.
              </p>
            </BestPractice>
          </div>
          <div class="tmpl__value">
            <p>
              A web browser and spreadsheet software. All datasets and practice materials are
              provided.
            </p>
          </div>
        </div>

        <div class="tmpl__field">
          <p class="tmpl__label tmpl__label--solo">Courses in this Specialization</p>
          <div class="ctable">
            <div class="ctable__head">
              <div class="ctable__cell">#</div>
              <div class="ctable__cell">
                <span class="ctable__label">Course title</span>
                <BestPractice title="Course title" size="sm">
                  <p>
                    Give each course a <strong
                      >distinct purpose within the larger learner journey</strong
                    >. Learners should be able to see how their capabilities will develop from one
                    course to the next.
                  </p>
                </BestPractice>
              </div>
              <div class="ctable__cell">
                <span class="ctable__label">Main outcomes</span>
                <BestPractice title="Main outcomes" size="sm">
                  <p>
                    Give each course an outcome that is <strong
                      >meaningful on its own while contributing to the larger Specialization
                      outcome</strong
                    >. Organize courses around meaningful stages of the work learners will do, rather
                    than dividing them simply by topic or amount of content.
                  </p>
                </BestPractice>
              </div>
              <div class="ctable__cell">
                <span class="ctable__label">Est. time</span>
                <BestPractice title="Est. time" size="sm" align="right">
                  <p>
                    Aim for a <strong
                      >reasonable and relatively balanced learner experience across courses</strong
                    >, while allowing the work itself to determine the exact length. Include all
                    learning activities (i.e., video, readings, activities, and assessments) in this
                    estimate.
                  </p>
                </BestPractice>
              </div>
            </div>
            {
              courses.map((c) => (
                <div class="ctable__row">
                  <div class="ctable__cell">{c.n}</div>
                  <div class="ctable__cell">{c.title}</div>
                  <div class="ctable__cell">{c.outcome}</div>
                  <div class="ctable__cell">{c.hours}</div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="tmpl__field">
          <div class="tmpl__labelrow">
            <p class="tmpl__label">Specialization project or culminating experience (optional)</p>
            <BestPractice title="Specialization project or culminating experience (optional)">
              <p>
                Use a culminating experience to help learners <strong
                  >integrate skills from across the Specialization</strong
                >, rather than simply repeat an assignment from the final course. Give learners a
                realistic problem, decision, product, or scenario that requires them to draw on
                multiple capabilities.
              </p>
            </BestPractice>
          </div>
          <div class="tmpl__value">
            <p>
              Learners investigate a business question using a provided dataset, clean and analyze
              the data, create visualizations to communicate key findings, and develop an
              evidence-informed recommendation for a business audience.
            </p>
          </div>
        </div>

        <div class="tmpl__cta">
          <a class="btn btn--level" href="#" data-template-link>Open the template in Google Docs ↗</a>
        </div>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .steprail--3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .step--last {
    padding-bottom: 8px;
  }

  .step__p--gap {
    margin-bottom: 36px;
  }

  /* The Specialization name inside the bolded lead-in stays upright. */
  .nostyle {
    font-style: normal;
  }

  /* --- "The goal" pull-out inside the worked example --------------------- */
  .goalbox {
    background: var(--tint);
    border-left: 3px solid var(--accent);
    padding: 20px 24px;
    margin: 0 0 16px;
  }

  .goalbox__eyebrow {
    margin: 0 0 8px;
    font-size: var(--fs-1);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent-dark);
  }

  .goalbox__body {
    margin: 0;
    font-size: var(--fs-3);
    line-height: 1.65;
    color: var(--text-strong);
    max-width: var(--measure-body);
  }

  /* --- Progression arc --------------------------------------------------- */
  .arc {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
  }

  .arc__step {
    background: var(--tint);
    border: 1px solid var(--tint-border);
    border-radius: var(--radius-panel);
    padding: 10px 16px;
    font-size: var(--fs-2);
    font-weight: 600;
    color: var(--accent-dark);
  }

  .arc__arrow {
    color: var(--copper);
    font-size: var(--fs-4);
  }

  /* --- Template ---------------------------------------------------------- */

  /* The label and its ⓘ trigger share a row; the row is the popover's
     positioning context, so it must not clip. */
  .tmpl__labelrow {
    position: relative;
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 12px;
  }

  .tmpl__labelrow .tmpl__label {
    margin: 0;
    white-space: nowrap;
  }

  .tmpl__label--solo {
    margin: 0 0 12px;
  }

  .tmpl__link-row {
    font-size: var(--fs-2);
    color: var(--text-secondary);
  }

  .tmpl__link-row .ext {
    color: var(--accent);
  }

  .tmpl__bar-note {
    color: #fff;
  }

  /* --- Courses table ----------------------------------------------------- */
  .ctable {
    border: 1px solid var(--rule-card);
    border-radius: 2px;
  }

  .ctable__head,
  .ctable__row {
    display: grid;
    grid-template-columns: 40px 1.3fr 1.5fr 110px;
  }

  .ctable__head {
    background: var(--tint);
    border-bottom: 1px solid var(--tint-border);
    border-radius: 2px 2px 0 0;
  }

  .ctable__head .ctable__cell {
    position: relative;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 12px;
    font-size: var(--fs-1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-dark);
    font-weight: 700;
    border-left: 1px solid var(--tint-border);
  }

  .ctable__label {
    white-space: nowrap;
  }

  .ctable__row {
    border-bottom: 1px solid var(--rule);
  }

  .ctable__row:last-child {
    border-bottom: 0;
  }

  .ctable__row .ctable__cell {
    padding: 14px 12px;
    font-size: var(--fs-2);
    line-height: 1.55;
    color: var(--text-body);
    border-left: 1px solid var(--rule);
    max-width: var(--measure-body);
  }

  .ctable__cell:first-child {
    border-left: 0;
  }

  .btn--level {
    background: var(--accent);
    color: #fff;
    font-size: var(--fs-2);
  }

  .btn--level:hover {
