---
import PageLayout from '../../layouts/PageLayout.astro';

/* Guidance that applies to every asset, so it lives on its own page rather
   than repeating inside all eight asset sections. Reached from the Learning
   Assets dropdown, where it is the emphasized child. */

const whenHelpful = [
  {
    title: 'While planning',
    body: 'Think ahead about the format, source materials, and tools you may want to use.',
  },
  {
    title: 'While developing',
    body: 'Find guidance for the text, media, interaction, or other content you’re creating.',
  },
  {
    title: 'Before handoff',
    body: 'Take stock of what’s in place and note anything you’d like to review with your Learning Experience Designer.',
  },
];

const chooser = [
  {
    slug: 'accessibility',
    title: 'Accessibility',
    blurb:
      'Plan content and interactions that learners with a range of access needs can use meaningfully.',
    cta: 'Explore accessibility →',
    cls: 'x--a11y',
  },
  {
    slug: 'copyright',
    title: 'Copyright and permissions',
    blurb:
      'Identify materials you did not create and work with your CTL team to confirm that they can be used in a public, commercial Course.',
    cta: 'Explore copyright →',
    cls: 'x--copyright',
  },
  {
    slug: 'ai',
    title: 'Using AI',
    blurb:
      'Use AI thoughtfully, protect material you share with AI tools, and carefully review anything AI contributes to the Course.',
    cta: 'Explore AI guidance →',
    cls: 'x--ai',
  },
];

const a11yGroups = [
  {
    title: 'Text and structure',
    items: [
      'Use a logical heading structure and consistent formatting.',
      'Use concise, direct language and explain specialized terminology or syntax.',
      'Provide instructions, code, feedback, and rubrics as selectable text.',
    ],
  },
  {
    title: 'Images and visuals',
    items: [
      'Provide alternative text for meaningful images.',
      'Describe complex charts, diagrams, and data in the surrounding content.',
      'Identify table headers clearly and avoid using color or position alone.',
    ],
  },
  {
    title: 'Video and audio',
    items: [
      'Review captions and transcripts, especially names and specialized terminology.',
      'Describe meaningful visual information aloud.',
      'Make essential names, citations, links, and resources available in writing.',
    ],
  },
  {
    title: 'Interaction and navigation',
    items: [
      'Design essential controls so they can be reached with a keyboard and assistive technology.',
      'Whenever possible, choose interactions that do not depend on dragging, hovering, speech, or precise movement.',
      'Provide accessible static resources for all interactions.',
    ],
  },
  {
    title: 'Multiple ways to engage',
    items: [
      'Pair color, sound, animation, images, and visual position with another way of understanding the information.',
      'Provide instructions and feedback in an accessible form learners can return to.',
      'Give flexibility in how quickly they work through a task.',
    ],
  },
  {
    title: 'Alternative paths',
    items: [
      'When a format creates a barrier unrelated to the objective, or is unavailable to some learners, provide another way to participate.',
      'Consider the accessibility of the complete environment learners will use, including third-party tools, editors, consoles, and visualizations.',
      'Ask learners only for information needed to complete the activity, avoiding personal or sensitive information whenever possible.',
    ],
  },
];

const a11yShare = [
  'Editable source files whenever possible',
  'What important images, charts, media, or interactions are meant to communicate',
  'Any tool, plugin, software, or file format learners will use',
  'Questions about alternatives or possible access barriers',
];

/* Two settings side by side, each a column of the same three points. */
const compare = [
  {
    eyebrow: 'In a Duke classroom',
    body: [
      'Course materials are shared with a defined group of enrolled students for a limited educational purpose. Depending on the material and how it is used, classroom exceptions, fair use, library licenses, Course Reserves, or other permissions may support limited use within that setting.',
      'These provisions do not mean that any material may be copied or shared for teaching. They apply under particular conditions and may limit who can access the material, how much can be used, and how long it remains available.',
    ],
  },
  {
    eyebrow: 'In a Coursera Course',
    body: [
      'Course materials are distributed through a public, global, commercial platform and may remain available well beyond an academic term. Permissions, licenses, and fair-use decisions made for a closed classroom may not extend to this setting.',
      'Materials generally need to be created for the Course, in the public domain, covered by a license that permits commercial use, or used with the rights holder’s permission. Bring other proposed uses to your CTL team for review.',
    ],
  },
];

const flagRows = [
  {
    material: 'Text and publications',
    flag: 'Articles, chapters, quotations, substantial excerpts, cases, scripts, exercises, or licensed question banks',
  },
  {
    material: 'Images and figures',
    flag: 'Photographs, illustrations, figures, charts, tables, or diagrams you did not create',
  },
  {
    material: 'Video, audio, and music',
    flag: 'Clips, footage, recordings, background music, or people appearing in a recording',
  },
  {
    material: 'Data and datasets',
    flag: 'Purchased, licensed, restricted, institutional, or third-party data',
  },
  {
    material: 'Code and software',
    flag: 'Starter code, libraries, packages, APIs, software, templates, or configured environments',
  },
  {
    material: 'Scenarios and personas',
    flag: 'Real people, copyrighted characters, proprietary cases, confidential situations, rubrics, or published exercises',
  },
  {
    material: 'Tools and platforms',
    flag: 'External tools, embedded content, accounts, data collection, privacy conditions, media, or simulations',
  },
  {
    material: 'What learners submit',
    flag: 'Anything learners are asked to upload, paste, or enter into an activity or AI conversation',
  },
];

/* NC is called out rather than listed alphabetically last by accident: it
   is the one row that does not clear on the licence alone. */
const ccLicenses = [
  {
    licence: 'CC0',
    use: 'Generally permitted',
    note: 'The creator has waived copyright restrictions to the extent legally possible. Attribution is appreciated even when it is not required.',
  },
  {
    licence: 'CC BY',
    use: 'Generally permitted',
    note: 'Commercial use and adaptation are allowed. Credit the creator and provide the license information.',
  },
  {
    licence: 'CC BY-SA',
    use: 'May be permitted',
    note: 'Commercial use and adaptation are allowed, but an adapted work must be shared under the same license. Review adaptations with your CTL team.',
  },
  {
    licence: 'CC BY-ND',
    use: 'May be permitted if unchanged',
    note: 'Commercial redistribution is allowed, but adaptations are not. Cropping, translating, editing, or otherwise modifying the work may require additional review.',
  },
  {
    licence: 'Any license containing NC',
    use: 'Not cleared for Coursera by the license alone',
    note: 'NC means noncommercial. Obtain additional permission from the rights holder before using the material in a Coursera Course.',
    flagged: true,
  },
];

const copyrightShare = [
  'A link to the original source',
  'The creator or rights holder, when known',
  'Any license, permission, or purchase information you already have',
  'How you would like to use the material (e.g., by reproducing, adapting, embedding, or linking to it)',
];

const confirmed = [
  'Attribute third-party materials and preserve any required license notices, including open-source notices.',
  'When material does not need to be reproduced in Coursera, consider linking learners to a lawful source.',
  'Protect private and sensitive information by keeping credentials, confidential data, private repositories, and personally identifiable information out of the Course.',
  'Confirm distribution rights for software, packages, datasets, templates, and starter files used in Labs.',
];

const aiCards = [
  {
    title: 'Protect what goes in',
    items: [
      'Use AI tools only with material you are permitted to share.',
      'Keep confidential, proprietary, personally identifiable, and restricted information out of AI tools.',
      'Consider what the AI provider may store, retain, or reuse.',
    ],
  },
  {
    title: 'Review what comes out',
    items: [
      'Verify facts, figures, citations, and disciplinary reasoning.',
      'Review for bias, stereotypes, close reproduction, and accessibility concerns.',
      'Revise the output to reflect your expertise, voice, learners, and objectives.',
    ],
  },
  {
    title: 'Keep your CTL team informed',
    items: [
      'Let your CTL team know when AI has contributed substantially to an asset.',
      'Share which tool you used and how you reviewed or revised its output.',
      'Bring forward any remaining questions about accuracy, rights, bias, accessibility, or appropriateness.',
    ],
  },
];

const aiShare = [
  'The AI tool you used',
  'How it contributed to the asset',
  'Any source material or instructions used to guide it',
  'What you have already verified or revised, and what you’d still like help reviewing',
];

const handoff = [
  'Have accessibility needs and possible alternatives been considered?',
  'Are editable and accessible source files available?',
  'Have third-party materials and their sources been identified?',
  'Are permission and attribution needs recorded?',
  'Has substantial AI-supported work been shared and reviewed?',
  'Are any open questions clearly noted for your CTL team?',
];
---

<PageLayout
  title="Accessibility, Copyright & AI"
  description="Guidance that applies to every Coursera learning asset: accessibility, copyright and permissions, and using AI during Course development."
  level="assets"
  breadcrumb="Accessibility, Copyright & AI"
  backToAssets
  nextTo={{
    dir: 'Asset guidance →',
    label: 'Video',
    href: '/learning-assets/video',
    color: 'var(--level-assets-dark)',
  }}
>
  <div class="levelpage" data-level="assets">
    <!-- Hero -->
    <div class="hero" data-cap="head">
      <div>
        <p class="eyebrow hero__eyebrow hero__eyebrow--neutral">Guidance for every Learning Asset</p>
        <h1 class="hero__title hero__title--tight">Accessibility, Copyright &amp; AI</h1>
        <p class="hero__lead hero__lead--strong">
          As you develop each Learning Asset, you’ll make choices that help it work well for
          learners, fit a public and commercial Coursera Course, and reflect your own expertise (even
          if AI has supported the process).
        </p>
        <p class="hero__lead">
          You and your Learning Experience Designer can return to this page throughout planning,
          production, and review. Use it to think through what applies to your work and identify
          questions to discuss together.
        </p>
      </div>

      <div class="hero__rail hero__rail--neutral">
        <p class="eyebrow hero__rail-eyebrow">When this page may be helpful</p>
        <div class="whenlist">
          {
            whenHelpful.map((w) => (
              <div class="whenlist__item">
                <p class="whenlist__title">{w.title}</p>
                <p class="whenlist__body">{w.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Chooser -->
    <section class="section section--open">
      <h2 class="xtitle">Three considerations throughout development</h2>
      <p class="prose prose--gap-lg">
        These questions may come up at different points in your project. Open the section that’s most
        useful for the asset or decision you’re working through with your Learning Experience
        Designer.
      </p>

      <div class="chooser">
        {
          chooser.map((c) => (
            <a class:list={['choicecard', c.cls]} href={`#${c.slug}`} data-keep>
              <div>
                <p class="choicecard__title">{c.title}</p>
                <p class="choicecard__blurb">{c.blurb}</p>
              </div>
              <p class="choicecard__cta">{c.cta}</p>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Accessibility -->
    <section class="section section--open x--a11y" id="accessibility">
      <p class="eyebrow xeyebrow">Return to this throughout development</p>
      <h2 class="xtitle">Build in accessibility</h2>
      <p class="prose">
        Accessibility is part of every Duke Coursera Learning Asset and is easiest to support when
        considered from the beginning. Early decisions about structure, media, tools, and
        interactions can make an asset easier for more learners to use <em>and</em> easier to produce
        accessibly.
      </p>
      <p class="prose prose--gap-lg">
        Share ideas and drafts with your Learning Experience Designer while there is still time to
        shape the approach together. They can help you identify what applies and plan for complex
        content, interactions, or possible access barriers.
      </p>

      <div class="groupcols">
        {
          a11yGroups.map((g) => (
            <div class="group">
              <p class="eyebrow group__head">{g.title}</p>
              <ul class="bullets bullets--group">
                {g.items.map((i) => <li>{i}</li>)}
              </ul>
            </div>
          ))
        }
      </div>

      <div class="sharepanel" data-keep>
        <p class="sharepanel__title">Helpful things to share with your Learning Experience Designer</p>
        <ul class="bullets bullets--share">
          {a11yShare.map((i) => <li>{i}</li>)}
        </ul>
      </div>
    </section>

    <!-- Copyright -->
    <section class="section section--open x--copyright" id="copyright">
      <p class="eyebrow xeyebrow">Return to this throughout development</p>
      <h2 class="xtitle">Copyright and permissions</h2>
      <p class="prose">
        Coursera is a public, global, commercial platform. That makes it different from a
        face-to-face, for-credit Duke Course, and materials you already use in teaching may need
        additional review, permission, or licensing before they can be included.
      </p>
      <p class="prose prose--gap-lg">
        Whenever possible, build from materials you created yourself. Even material free to access
        online can have restrictions on the rights to reproduce, adapt, or distribute through
        Coursera.
      </p>

      <h3 class="xsub">Why Coursera is different</h3>
      <div class="compare">
        {
          compare.map((c, i) => (
            <div class:list={['compare__col', i === 1 && 'compare__col--now']} data-keep>
              <p class="eyebrow compare__eyebrow">{c.eyebrow}</p>
              {c.body.map((b, j) => (
                <p class:list={['compare__body', j === c.body.length - 1 && 'compare__body--last']}>
                  {b}
                </p>
              ))}
            </div>
          ))
        }
      </div>

      <h3 class="xsub xsub--spaced">Educational use is not automatically fair use</h3>
      <p class="prose">
        Fair use may allow copyrighted material to be used without permission in some circumstances,
        but each use must be considered individually. The analysis includes the purpose of the use,
        the nature of the material, how much is used, and the effect on the market for the original.
      </p>
      <p class="prose prose--flush">
        A nonprofit educational purpose can support fair use, while a commercial context may weigh
        against it—but neither factor decides the question on its own. Because Coursera differs from
        a closed, for-credit classroom, share any proposed reliance on fair use with your CTL team.
      </p>

      <h3 class="xsub xsub--spaced">Keep track of materials you did not create</h3>
      <p class="prose prose--gap">
        As you develop an asset, take note when it includes anything you didn’t create and where it
        came from. Your CTL team can help you understand what may be used, what may require
        permission, and what might be better replaced.
      </p>

      <div class="flagtable" data-keep>
        <div class="flagtable__head">
          <div class="flagtable__cell">Material</div>
          <div class="flagtable__cell">Take note when it includes</div>
        </div>
        {
          flagRows.map((r) => (
            <div class="flagtable__row">
              <div class="flagtable__cell flagtable__cell--key">{r.material}</div>
              <div class="flagtable__cell">{r.flag}</div>
            </div>
          ))
        }
      </div>

      <!-- Licence detail most faculty will not need on a first read, so it
           is collapsed by default and forced open for the PDF. -->
      <div class="disclose" data-disclose data-open="false">
        <button
          class="disclose__head"
          type="button"
          aria-expanded="false"
          aria-controls="cc-panel"
          id="cc-btn"
        >
          <span class="disclose__title">Using Creative Commons materials</span>
          <span class="disclose__toggle">Show license guidance</span>
        </button>

        <div class="disclose__panel" id="cc-panel" role="region" aria-labelledby="cc-btn">
          <p class="prose prose--gap">
            A Creative Commons license gives the public permission to use a work under stated
            conditions. Check the exact license attached to the material—not simply whether it has a
            Creative Commons symbol.
          </p>

          <div class="cctable" data-keep>
            <div class="cctable__head">
              <div class="cctable__cell">License</div>
              <div class="cctable__cell">Use in Coursera</div>
              <div class="cctable__cell">What to keep in mind</div>
            </div>
            {
              ccLicenses.map((l) => (
                <div class:list={['cctable__row', l.flagged && 'cctable__row--flagged']}>
                  <div class="cctable__cell cctable__cell--licence">{l.licence}</div>
                  <div
                    class:list={['cctable__cell', 'cctable__cell--use', l.flagged && 'cctable__cell--use-flagged']}
                  >
                    {l.use}
                  </div>
                  <div class="cctable__cell">{l.note}</div>
                </div>
              ))
            }
          </div>

          <p class="prose prose--flush">
            All Creative Commons licenses require you to follow their conditions. Unless the work is
            marked CC0, plan to identify the creator, title, source, and license and indicate whether
            you made changes.
          </p>
        </div>
      </div>

      <div class="sharepanel" data-keep>
        <p class="sharepanel__title">Helpful things to share with your CTL team</p>
        <ul class="bullets bullets--share">
          {copyrightShare.map((i) => <li>{i}</li>)}
        </ul>
      </div>

      <h3 class="xsub xsub--spaced">After permission or use is confirmed</h3>
      <div class="checklist">
        {
          confirmed.map((c) => (
            <div class="checklist__row" data-keep>
              <span class="checklist__box" aria-hidden="true" />
              <p class="checklist__text">{c}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Using AI -->
    <section class="section section--open x--ai" id="ai">
      <p class="eyebrow xeyebrow">Return to this when AI supports your work</p>
      <h2 class="xtitle">Using AI during Course development</h2>
      <p class="prose">
        AI tools can be useful for brainstorming, drafting, restructuring, summarizing, or generating
        examples and practice questions. They can also introduce errors, bias, privacy concerns, and
        copyright questions that aren’t always easy to spot.
      </p>
      <p class="prose prose--gap-xl">
        Your expertise remains central. Treat anything an AI tool produces as a starting point to
        verify, revise, and shape before it reaches learners.
      </p>

      <div class="aicards">
        {
          aiCards.map((c) => (
            <div class="aicard" data-keep>
              <p class="aicard__title">{c.title}</p>
              <ul class="bullets bullets--group">
                {c.items.map((i) => <li>{i}</li>)}
              </ul>
            </div>
          ))
        }
      </div>

      <div class="sharepanel" data-keep>
        <p class="sharepanel__title">Helpful things to share with your Learning Experience Designer</p>
        <ul class="bullets bullets--share">
          {aiShare.map((i) => <li>{i}</li>)}
        </ul>
      </div>
    </section>

    <!-- Handoff -->
    <section class="section section--open x--ai">
      <h2 class="xtitle">As you prepare for handoff</h2>
      <p class="prose prose--gap-lg">
        Use these questions with your Learning Experience Designer to take stock of what’s ready and
        what may still need attention.
      </p>

      <div class="checklist">
        {
          handoff.map((h) => (
            <div class="checklist__row" data-keep>
              <span class="checklist__box" aria-hidden="true" />
              <p class="checklist__text">{h}</p>
            </div>
          ))
        }
      </div>

      <p class="prose prose--top">
        Record relevant decisions and source links in the Design Document so the team can carry them
        into production.
      </p>
    </section>
  </div>
</PageLayout>

<style>
  /* Each of the three concerns carries its own accent, used on the chooser
     card, the section eyebrow, and that section's panels. */
  .x--a11y {
    --x: var(--dim-a11y);
    --x-text: var(--dim-a11y-text);
    --x-deep: var(--note-teal-title);
    --x-tint: var(--note-teal-bg);
  }

  .x--copyright {
    --x: var(--dim-copyright);
    --x-text: var(--warn-title);
    --x-deep: var(--copper-deep);
    --x-tint: var(--warn-bg);
  }

  .x--ai {
    --x: var(--text-body);
    --x-text: var(--ai-deep);
    --x-deep: var(--ai-deep);
    --x-tint: var(--panel-neutral);
  }

  /* --- Hero ---------------------------------------------------------------- */
  .hero__eyebrow--neutral {
    color: var(--text-body);
  }

  .hero__title--tight {
    line-height: 1.08;
  }

  .hero__lead--strong {
    color: var(--text-strong);
  }

  .hero__rail--neutral {
    border-left-color: var(--text-body);
  }

  /* Hairlines between the three moments, so the rail reads as a sequence. */
  .whenlist {
    display: flex;
    flex-direction: column;
  }

  .whenlist__item {
    padding: 18px 0;
    border-top: 1px solid var(--rule);
  }

  .whenlist__item:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .whenlist__item:last-child {
    padding-bottom: 0;
  }

  .whenlist__title {
    margin: 0 0 5px;
    font-family: var(--font-display);
    font-size: 21px;
    color: var(--navy);
  }

  .whenlist__body {
    margin: 0;
    font-size: var(--fs-2);
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 340px;
  }

  /* --- Shared section furniture -------------------------------------------- */
  .section--open {
    padding: 68px var(--section-pad-x) 0;
    scroll-margin-top: 12px;
  }

  .xeyebrow {
    margin: 0 0 12px;
    letter-spacing: 0.17em;
    color: var(--x-text);
  }

  .xtitle {
    margin: 0 0 16px;
    font-size: var(--fs-7);
    line-height: 1.15;
  }

  .xsub {
    margin: 0 0 16px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 25px;
    line-height: 1.2;
    color: var(--navy);
  }

  .xsub--spaced {
    margin-top: 36px;
    margin-bottom: 12px;
  }

  .prose {
    margin: 0 0 17px;
    font-size: var(--fs-3);
    line-height: 1.7;
    color: var(--text-body);
    max-width: var(--measure-body);
  }

  .prose--flush {
    margin-bottom: 0;
  }

  .prose--gap {
    margin-bottom: 26px;
  }

  .prose--gap-lg {
    margin-bottom: 32px;
  }

  .prose--gap-xl {
    margin-bottom: 34px;
  }

  .prose--top {
    margin: 26px 0 0;
  }

  /* --- Chooser cards -------------------------------------------------------- */
  .chooser {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .choicecard {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 18px;
    min-height: 210px;
    border: 1px solid var(--rule-card);
    border-top: 4px solid var(--x);
    border-radius: var(--radius-panel);
    padding: 24px 26px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .choicecard:hover {
    border-color: var(--x);
    box-shadow: var(--shadow-hover);
  }

  .choicecard__title {
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 25px;
    line-height: 1.2;
    color: var(--navy);
  }

  .choicecard__blurb {
    margin: 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-body);
  }

  .choicecard__cta {
    margin: 0;
    font-size: var(--fs-2);
    font-weight: 600;
    color: var(--x-text);
  }

  /* --- Grouped considerations ----------------------------------------------- */

  /* Newspaper columns rather than a grid: the six groups are close in
     height, and columns keep each one whole across the break. */
  .groupcols {
    columns: 2;
    column-gap: 40px;
  }

  .group {
    min-width: 0;
    break-inside: avoid;
    -webkit-column-break-inside: avoid;
    margin: 0 0 30px;
  }

  .group__head {
    margin: 0 0 14px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--x);
    letter-spacing: 0.14em;
    color: var(--x-text);
  }

  .bullets--group {
    --bullet-color: var(--x-text);
    gap: 11px;
  }

  .bullets--group li {
    font-size: var(--fs-2);
    line-height: 1.65;
    padding-left: 15px;
    color: var(--text-body);
  }

  /* --- Tinted aside, in the section's own accent ---------------------------- */
  .sharepanel {
    background: var(--x-tint);
    border-left: 3px solid var(--x);
    padding: 24px 28px;
    margin: 32px 0 0;
  }

  .sharepanel__title {
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-5);
    color: var(--navy);
  }

  /* Panel bullets sit a step up in size from the column lists, and take the
     section's deepest accent. */
  .bullets--share {
    --bullet-color: var(--x-deep);
    gap: 10px;
  }

  .bullets--share li {
    font-size: 16px;
    line-height: 1.65;
    padding-left: 16px;
    color: var(--text-body);
    max-width: 740px;
  }

  /* --- Classroom vs Coursera ------------------------------------------------ */

  /* The design lays this out as a 2x3 cell grid so the two settings' points
     line up row by row. Kept as two column blocks instead — so each label
     is read with its own paragraphs rather than the two columns
     interleaving — with `subgrid` restoring the row alignment. Where
     subgrid is unsupported the columns simply size independently, which
     reads correctly and only loses the row-to-row alignment. */
  .compare {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: auto auto auto;
    column-gap: 40px;
    row-gap: 0;
  }

  .compare__col {
    grid-row: span 3;
    padding: 2px 0 2px 22px;
    border-left: 3px solid var(--rule-strong);
  }

  @supports (grid-template-rows: subgrid) {
    .compare__col {
      display: grid;
      grid-template-rows: subgrid;
    }
  }

  .compare__col--now {
    border-left-color: var(--dim-copyright);
  }

  .compare__eyebrow {
    margin: 0 0 12px;
    letter-spacing: 0.16em;
    color: var(--text-muted);
  }

  .compare__col--now .compare__eyebrow {
    color: var(--warn-title);
  }

  .compare__body {
    margin: 0 0 18px;
    font-size: var(--fs-3);
    line-height: 1.7;
    color: var(--text-body);
  }

  .compare__body--last {
    margin-bottom: 0;
  }

  /* --- What to take note of ------------------------------------------------- */
  .flagtable {
    border: 1px solid var(--rule-card);
    border-radius: var(--radius-panel);
    overflow: hidden;
  }

  .flagtable__head,
  .flagtable__row {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
  }

  .flagtable__head {
    background: var(--warn-bg);
    border-bottom: 1px solid var(--warn-border);
    font-size: var(--fs-1);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--copper-deep);
    font-weight: 700;
  }

  .flagtable__head .flagtable__cell {
    padding: 14px 22px;
    white-space: nowrap;
    border-left-color: var(--warn-border);
  }

  .flagtable__row {
    border-bottom: 1px solid var(--rule);
  }

  .flagtable__row:last-child {
    border-bottom: 0;
  }

  .flagtable__cell {
    padding: 16px 22px;
    font-size: var(--fs-3);
    line-height: 1.6;
    color: var(--text-body);
    border-left: 1px solid var(--rule);
  }

  .flagtable__cell:first-child {
    border-left: 0;
  }

  .flagtable__cell--key {
    font-weight: 600;
    line-height: 1.5;
    color: var(--navy);
  }

  /* --- Creative Commons disclosure ------------------------------------------ */
  .disclose {
    margin: 36px 0 0;
    border: 1px solid var(--rule-card);
    border-radius: var(--radius-panel);
    overflow: hidden;
  }

  .disclose__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    text-align: left;
    font: inherit;
    border: 0;
    background: var(--warn-bg);
    padding: 20px 26px;
    cursor: pointer;
  }

  .disclose__head:hover {
    background: var(--warn-bg-hover);
  }

  .disclose__head:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: -2px;
  }

  .disclose__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 25px;
    line-height: 1.2;
    color: var(--navy);
  }

  .disclose__toggle {
    flex: none;
    font-size: var(--fs-2);
    font-weight: 600;
    color: var(--copper-deep);
    white-space: nowrap;
  }

  .disclose__panel {
    padding: 26px;
    border-top: 1px solid var(--warn-border);
  }

  .disclose[data-open='false'] .disclose__panel {
    display: none;
  }

  .cctable {
    border: 1px solid var(--rule-card);
    border-radius: var(--radius-panel);
    overflow: hidden;
    margin: 0 0 22px;
  }

  .cctable__head,
  .cctable__row {
    display: grid;
    grid-template-columns: 210px 230px minmax(0, 1fr);
  }

  .cctable__head {
    background: var(--warn-bg);
    border-bottom: 1px solid var(--warn-border);
    font-size: var(--fs-1);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--copper-deep);
    font-weight: 700;
  }

  .cctable__head .cctable__cell {
    padding: 14px 20px;
    white-space: nowrap;
    border-left-color: var(--warn-border);
  }

  .cctable__row {
    border-bottom: 1px solid var(--rule);
  }

  .cctable__row:last-child {
    border-bottom: 0;
  }

  /* The one licence family that a licence check alone cannot clear. */
  .cctable__row--flagged {
    background: var(--warn-bg);
  }

  .cctable__cell {
    padding: 16px 20px;
    font-size: var(--fs-3);
    line-height: 1.6;
    color: var(--text-body);
    border-left: 1px solid var(--rule);
  }

  .cctable__cell:first-child {
    border-left: 0;
  }

  .cctable__cell--licence {
    font-weight: 700;
    line-height: 1.5;
    color: var(--navy);
  }

  .cctable__cell--use {
    font-weight: 600;
    color: var(--text-strong);
  }

  .cctable__cell--use-flagged {
    color: var(--copper-deep);
  }

  /* --- Checklists ----------------------------------------------------------- */
  .checklist {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--rule);
  }

  .checklist__row {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    gap: 16px;
    align-items: start;
    padding: 18px 0;
    border-bottom: 1px solid var(--rule);
  }

  .checklist__box {
    flex: none;
    width: 22px;
    height: 22px;
    margin-top: 1px;
    border-radius: var(--radius-panel);
    border: 2px solid var(--x);
    display: block;
  }

  .checklist__text {
    margin: 0;
    font-size: var(--fs-3);
    line-height: 1.7;
    color: var(--text-body);
    max-width: 700px;
  }

  /* --- Using AI cards -------------------------------------------------------- */
  .aicards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .aicard {
    border: 1px solid var(--rule-card);
    border-top: 4px solid var(--x);
    border-radius: var(--radius-panel);
    padding: 24px 26px;
  }

  .aicard__title {
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 24px;
    line-height: 1.2;
    color: var(--navy);
  }

  /* The AI cards' bullets sit on white, so they take the strong body colour
     rather than the section's deepest accent. */
  .x--ai .aicard .bullets--group {
    --bullet-color: var(--text-strong);
  }

  @media print {
    /* The licence table is expanded for the PDF, and the toggle is
       meaningless on paper. */
    .disclose__panel {
      display: block !important;
    }

    .disclose__toggle {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-disclose]').forEach((el) => {
    const head = el.querySelector<HTMLButtonElement>('.disclose__head')!;
    const toggle = el.querySelector<HTMLElement>('.disclose__toggle')!;

    const set = (open: boolean) => {
      el.dataset.open = String(open);
      head.setAttribute('aria-expanded', String(open));
      toggle.textContent = open ? 'Hide' : 'Show license guidance';
    };

    head.addEventListener('click', () => set(el.dataset.open !== 'true'));

    // These pages get exported to PDF for review, so nothing may stay
    // hidden in the print output.
    let before = false;
    window.addEventListener('beforeprint', () => {
      before = el.dataset.open === 'true';
      set(true);
    });
    window.addEventListener('afterprint', () => set(before));
  });
</script>
