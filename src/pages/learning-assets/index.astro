---
import PageLayout from '../../layouts/PageLayout.astro';
import { learningAssets } from '../../data/learning-assets';
import { assetPageLive, sharedGuidance, url } from '../../data/site';

const phases = [
  {
    title: 'When planning',
    body: 'Consider why the format fits this part of the learning path and what learners need from it.',
  },
  {
    title: 'While drafting',
    body: 'Use the examples, prompts, and templates to help shape the asset.',
  },
  {
    title: 'As you prepare to share it',
    body: 'Review the draft with your CTL team and note anything you’d still like to work through.',
  },
];
---

<PageLayout
  title="Learning Assets"
  description="Choose the Coursera learning asset you're building, with considerations and resources for developing each one."
  level="assets"
  nextTo={{
    dir: 'Helpful throughout →',
    label: 'Accessibility, Copyright & AI',
    href: sharedGuidance.href,
    color: 'var(--text-body)',
  }}
>
  <div class="levelpage" data-level="assets">
    <!-- Hero -->
    <div class="hero" data-cap="head">
      <div>
        <p class="eyebrow hero__eyebrow">Learning Assets</p>
        <h1 class="hero__title">Designing Learning Assets</h1>
        <p class="hero__lead hero__lead--strong">
          Once you’ve planned a Module’s learning path, you and your Learning Experience Designer can
          begin developing the Videos, Readings, Assessments, and other assets that bring it to life.
        </p>
        <p class="hero__lead">
          Creating an online asset often requires more intentional planning than preparing for a
          class session. Explanations, instructions, examples, feedback, and learner support need to
          be built into the asset, because you will not be present to clarify them in the moment.
        </p>
        <p class="hero__lead">
          Come back to this section throughout development. Open the guide for the asset you’re
          working on, and use the shared accessibility, copyright, and AI guidance as questions come
          up along the way.
        </p>
      </div>

      <nav class="hero__rail" aria-label="On this page">
        <p class="eyebrow hero__rail-eyebrow hero__rail-eyebrow--gold">Coursera assets</p>
        <div class="jumplist">
          {
            learningAssets.map((a) => (
              <a class="jumplist__link" href={`#${a.slug}`}>
                <svg
                  class="jumplist__icon"
                  viewBox="0 0 24 24"
                  width="19"
                  height="19"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={a.icon}
                />
                {a.railLabel}
              </a>
            ))
          }
        </div>

        <div class="railout">
          <p class="railout__title">Helpful throughout development</p>
          <a class="railout__link" href={url(sharedGuidance.href)}>
            {sharedGuidance.label} →
          </a>
        </div>
      </nav>
    </div>

    <!-- From Module plan to Learning Assets -->
    <section class="section section--open">
      <h2 class="xtitle">From Module plan to Learning Assets</h2>
      <p class="prose prose--gap-lg">
        Once you have identified the assets your Module needs, use this page as you begin developing
        them. Each section highlights a few important considerations for that asset type and points
        to any available templates or resources.
      </p>

      <div class="phases">
        {
          phases.map((p) => (
            <div class="phase">
              <p class="phase__title">{p.title}</p>
              <p class="phase__body">{p.body}</p>
            </div>
          ))
        }
      </div>

      <div class="promo" data-keep>
        <div>
          <p class="promo__title">Accessibility, Copyright &amp; AI</p>
          <p class="promo__body">
            Creating learning assets for a public, commercial platform like Coursera brings important
            accessibility, copyright, and AI considerations that may be less familiar from a
            for-credit classroom. Address these considerations throughout development, returning to
            this reference as you work on each asset with your Learning Experience Designer.
          </p>
        </div>
        <a class="btn btn--gold" href={url(sharedGuidance.href)}>Explore the shared guidance →</a>
      </div>
    </section>

    <!-- Choose the asset -->
    <section class="section section--open section--last">
      <h2 class="xtitle">Choose the Learning Asset you’re building</h2>
      <p class="prose prose--gap-lg">
        Select an asset type below to find considerations and resources for developing it.
      </p>

      <div class="assetgrid">
        {
          learningAssets.map((a) => (
            <div class="assetcard" id={a.slug} data-keep>
              <div>
                <div class="assetcard__head">
                  <svg
                    class="assetcard__icon"
                    viewBox="0 0 24 24"
                    width="26"
                    height="26"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={a.icon}
                  />
                  <p class="assetcard__title">{a.railLabel}</p>
                </div>

                <p class="eyebrow assetcard__label">
                  {a.plural ? 'What are they?' : 'What is it?'}
                </p>
                <p class="assetcard__body">{a.whatIs}</p>

                <p class="eyebrow assetcard__label">
                  {a.plural ? 'When might you use them?' : 'When might you use it?'}
                </p>
                <p class="assetcard__body assetcard__body--last">{a.whenToUse}</p>
              </div>

              {
                assetPageLive(a) ? (
                  <a class="assetcard__more" href={url(a.page!)}>
                    Explore {a.exploreLabel ?? a.railLabel} →
                  </a>
                ) : (
                  /* Held back until all eight guides are ready to share.
                     See assetGuidesReleased in site.ts. */
                  <span class="assetcard__soon">Available soon</span>
                )
              }
            </div>
          ))
        }
      </div>
    </section>
  </div>
</PageLayout>

<style>
  /* --- Hero ---------------------------------------------------------------- */
  .hero__lead--strong {
    color: var(--text-strong);
  }

  .hero__rail-eyebrow--gold {
    margin-bottom: 16px;
    letter-spacing: 0.16em;
    color: var(--level-assets-dark);
  }

  .jumplist {
    display: flex;
    flex-direction: column;
  }

  .jumplist__link {
    text-decoration: none;
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 10px 0;
    border-top: 1px solid var(--rule);
    font-size: var(--fs-2);
    color: var(--text-strong);
  }

  .jumplist__link:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .jumplist__link:hover {
    color: var(--level-assets-dark);
  }

  /* The icon keeps its gold stroke while the label darkens on hover, so
     `color` cannot drive both. */
  .jumplist__icon {
    display: block;
    flex: none;
    color: var(--level-assets-dark);
  }

  /* Closes the rail with a pointer to the guidance that spans every asset. */
  .railout {
    margin: 24px 0 0;
    padding: 20px 0 0;
    border-top: 1px solid var(--rule);
  }

  .railout__title {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-size: 21px;
    color: var(--navy);
  }

  .railout__link {
    font-size: var(--fs-2);
    font-weight: 600;
    color: var(--level-assets-dark);
    text-decoration: none;
  }

  .railout__link:hover {
    text-decoration: underline;
    color: var(--level-assets-dark);
  }

  /* --- Sections ------------------------------------------------------------ */
  .section--open {
    padding: 68px var(--section-pad-x) 0;
  }

  .section--last {
    padding-bottom: 8px;
  }

  .xtitle {
    margin: 0 0 16px;
    font-size: var(--fs-7);
    line-height: 1.15;
  }

  .prose {
    margin: 0 0 17px;
    font-size: var(--fs-3);
    line-height: 1.7;
    color: var(--text-body);
    max-width: var(--measure-body);
  }

  .prose--gap-lg {
    margin-bottom: 32px;
  }

  /* --- Three phases of development ----------------------------------------- */
  .phases {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }

  .phase {
    border-top: 3px solid var(--level-assets);
    padding: 20px 0 0;
  }

  .phase__title {
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-size: 23px;
    line-height: 1.25;
    color: var(--navy);
  }

  .phase__body {
    margin: 0;
    font-size: var(--fs-3);
    line-height: 1.7;
    color: var(--text-body);
  }

  /* --- Shared-guidance promo ------------------------------------------------ */
  .promo {
    margin: 34px 0 0;
    background: var(--level-assets-tint);
    border: 1px solid var(--level-assets-tint-border);
    border-radius: var(--radius-panel);
    padding: 26px 28px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 32px;
    align-items: center;
  }

  .promo__title {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 24px;
    color: var(--navy);
  }

  .promo__body {
    margin: 0;
    font-size: var(--fs-3);
    line-height: 1.7;
    color: var(--text-body);
    max-width: var(--measure-section);
  }

  .btn--gold {
    flex: none;
    align-self: center;
    background: var(--level-assets-dark);
    color: #fff;
    font-size: var(--fs-2);
    font-weight: 700;
    padding: 13px 24px;
  }

  .btn--gold:hover {
    background: var(--gold-body);
    color: #fff;
  }

  /* --- Asset cards ---------------------------------------------------------- */
  .assetgrid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .assetcard {
    border: 1px solid var(--rule-card);
    border-top: 4px solid var(--level-assets);
    border-radius: var(--radius-panel);
    padding: 26px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    scroll-margin-top: 12px;
  }

  .assetcard__head {
    display: flex;
    align-items: center;
    gap: 13px;
    margin: 0 0 18px;
  }

  .assetcard__icon {
    display: block;
    flex: none;
    color: var(--level-assets-dark);
  }

  .assetcard__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 25px;
    line-height: 1.2;
    color: var(--navy);
    white-space: nowrap;
  }

  .assetcard__label {
    margin: 0 0 6px;
    letter-spacing: 0.14em;
    color: var(--level-assets-dark);
  }

  .assetcard__body {
    margin: 0 0 16px;
    font-size: var(--fs-3);
    line-height: 1.7;
    color: var(--text-body);
  }

  .assetcard__body--last {
    margin-bottom: 0;
  }

  .assetcard__more {
    font-size: var(--fs-2);
    font-weight: 600;
    color: var(--level-assets-dark);
    text-decoration: none;
  }

  .assetcard__more:hover {
    text-decoration: underline;
    color: var(--level-assets-dark);
  }

  /* Reads as a status, not a disabled link — no arrow, no link colour, and
     nothing to click. */
  .assetcard__soon {
    align-self: flex-start;
    display: inline-block;
    padding: 7px 13px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-panel);
    background: var(--panel-warm);
    font-size: var(--fs-1);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }
</style>
