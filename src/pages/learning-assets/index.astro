---
import PageLayout from '../../layouts/PageLayout.astro';
import assetData from '../../data/learning-assets-data.json';
import { assetLinks, sharedGuidance, url } from '../../data/site';

interface Asset {
  n: string;
  slug: string;
  use: string;
  note?: string;
  /** The short considerations shown on this page's asset cards. */
  d: string[];
  /** Long-form accessibility and copyright guidance. Superseded by the
      shared-guidance page and no longer rendered — kept as a record of
      where that content came from. */
  a: string[];
  c: string[];
}

/* Built from the data file, not by hand. Order comes from assetLinks so the
   nav dropdown, the hero jump list, and the cards below cannot drift. */
const assets = assetLinks.map((link, i) => {
  const data = (assetData as Asset[]).find((a) => a.slug === link.slug)!;
  return { ...data, link, index: String(i + 1).padStart(2, '0') };
});

const phases = [
  {
    title: 'When planning',
    body: 'Consider why the format fits this part of the learning path and what learners need from it.',
  },
  {
    title: 'While drafting',
    body: 'Use the examples, prompts, and templates to help shape the asset.',
  },
  {
    title: 'As you prepare to share it',
    body: 'Review the draft with your CTL team and note anything you’d still like to work through.',
  },
];
---

<PageLayout
  title="Learning Assets"
  description="Choose the Coursera learning asset you're building, with considerations and resources for developing each one."
  level="assets"
  nextTo={{
    dir: 'Helpful throughout →',
    label: 'Accessibility, Copyright & AI',
    href: sharedGuidance.href,
    color: 'var(--text-body)',
  }}
>
  <div class="levelpage" data-level="assets">
    <!-- Hero -->
    <div class="hero" data-cap="head">
      <div>
        <p class="eyebrow hero__eyebrow">Learning Assets</p>
        <h1 class="hero__title">Designing Learning Assets</h1>
        <p class="hero__lead hero__lead--strong">
          Once you’ve planned a Module’s learning path, you and your Learning Experience Designer can
          begin developing the Videos, Readings, Assessments, and other assets that bring it to life.
        </p>
        <p class="hero__lead">
          Creating an online asset often requires more intentional planning than preparing for a
          class session. Explanations, instructions, examples, feedback, and learner support need to
          be built into the asset, because you will not be present to clarify them in the moment.
        </p>
        <p class="hero__lead">
          Come back to this section throughout development. Open the guide for the asset you’re
          working on, and use the shared accessibility, copyright, and AI guidance as questions come
          up along the way.
        </p>
      </div>

      <nav class="hero__rail" aria-label="On this page">
        <p class="eyebrow hero__rail-eyebrow">Coursera assets</p>
        <div class="jumplist">
          {
            assets.map((a) => (
              <a class="jumplist__link" href={`#${a.slug}`}>
                <span class="jumplist__n">{a.index}</span>
                {a.n}
              </a>
            ))
          }
        </div>

        <div class="railout">
          <p class="railout__title">Helpful throughout development</p>
          <a class="railout__link" href={url(sharedGuidance.href)}>
            {sharedGuidance.label} →
          </a>
        </div>
      </nav>
    </div>

    <!-- From Module plan to Learning Assets -->
    <section class="section section--open">
      <h2 class="xtitle">From Module plan to Learning Assets</h2>
      <p class="prose prose--gap-lg">
        Once you have identified the assets your Module needs, use this page as you begin developing
        them. Each section highlights a few important considerations for that asset type and points
        to any available templates or resources.
      </p>

      <div class="phases">
        {
          phases.map((p) => (
            <div class="phase">
              <p class="phase__title">{p.title}</p>
              <p class="phase__body">{p.body}</p>
            </div>
          ))
        }
      </div>

      <div class="promo" data-keep>
        <div>
          <p class="promo__title">Accessibility, Copyright &amp; AI</p>
          <p class="promo__body">
            Creating learning assets for a public, commercial platform like Coursera brings important
            accessibility, copyright, and AI considerations that may be less familiar from a
            for-credit classroom. Address these considerations throughout development, returning to
            this reference as you work on each asset with your Learning Experience Designer.
          </p>
        </div>
        <a class="btn btn--gold" href={url(sharedGuidance.href)}>Explore the shared guidance →</a>
      </div>
    </section>

    <!-- Choose the asset -->
    <section class="section section--open section--last">
      <h2 class="xtitle">Choose the Learning Asset you’re building</h2>
      <p class="prose prose--gap-lg">
        Select an asset type below to find considerations and resources for developing it.
      </p>

      <div class="assetgrid">
        {
          assets.map((a) => (
            <div class="assetcard" id={a.slug} data-keep>
              <div>
                <div class="assetcard__head">
                  <span class="eyebrow assetcard__index">{a.index}</span>
                  <p class="assetcard__title">{a.n}</p>
                </div>

                <p class="assetcard__use">{a.use}</p>
                {a.note && <p class="assetcard__note">{a.note}</p>}

                <ul class="bullets bullets--asset">
                  {a.d.map((item) => <li>{item}</li>)}
                </ul>
              </div>

              <a
                class:list={['assetcard__more', !a.link.page && 'assetcard__more--pending']}
                href={a.link.page ? url(a.link.page) : undefined}
                aria-disabled={a.link.page ? undefined : 'true'}
              >
                {a.link.guidance}
              </a>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</PageLayout>

<style>
  /* --- Hero ---------------------------------------------------------------- */
  .hero__lead--strong {
    color: var(--text-strong);
  }

  .jumplist {
    display: flex;
    flex-direction: column;
  }

  .jumplist__link {
    text-decoration: none;
    display: flex;
    gap: 12px;
    align-items: baseline;
    padding: 9px 0;
    border-top: 1px solid var(--rule);
    font-size: var(--fs-2);
    color: var(--text-strong);
  }

  .jumplist__link:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .jumplist__link:hover {
    color: var(--level-assets-dark);
  }

  .jumplist__n {
    flex: none;
    font-size: var(--fs-1);
    color: var(--text-subtle);
    font-weight: 700;
  }

  /* Closes the rail with a pointer to the guidance that spans every asset. */
  .railout {
    margin: 24px 0 0;
    padding: 20px 0 0;
    border-top: 1px solid var(--rule);
  }

  .railout__title {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-size: 21px;
    color: var(--navy);
  }

  .railout__link {
    font-size: var(--fs-2);
    font-weight: 600;
    color: var(--level-assets-dark);
    text-decoration: none;
  }

  .railout__link:hover {
    text-decoration: underline;
    color: var(--level-assets-dark);
  }

  /* --- Sections ------------------------------------------------------------ */
  .section--open {
    padding: 68px var(--section-pad-x) 0;
  }

  .section--last {
    padding-bottom: 8px;
  }

  .xtitle {
    margin: 0 0 16px;
    font-size: var(--fs-7);
    line-height: 1.15;
  }

  .prose {
    margin: 0 0 17px;
    font-size: var(--fs-3);
    line-height: 1.7;
    color: var(--text-body);
    max-width: var(--measure-body);
  }

  .prose--gap-lg {
    margin-bottom: 32px;
  }

  /* --- Three phases of development ----------------------------------------- */
  .phases {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }

  .phase {
    border-top: 3px solid var(--level-assets);
    padding: 20px 0 0;
  }

  .phase__title {
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-size: 23px;
    line-height: 1.25;
    color: var(--navy);
  }

  .phase__body {
    margin: 0;
    font-size: var(--fs-3);
    line-height: 1.7;
    color: var(--text-body);
  }

  /* --- Shared-guidance promo ------------------------------------------------ */
  .promo {
    margin: 34px 0 0;
    background: var(--level-assets-tint);
    border: 1px solid var(--level-assets-tint-border);
    border-radius: var(--radius-panel);
    padding: 26px 28px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 32px;
    align-items: center;
  }

  .promo__title {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 24px;
    color: var(--navy);
  }

  .promo__body {
    margin: 0;
    font-size: var(--fs-3);
    line-height: 1.7;
    color: var(--text-body);
    max-width: var(--measure-body);
  }

  .btn--gold {
    flex: none;
    align-self: center;
    background: var(--level-assets-dark);
    color: #fff;
    font-size: var(--fs-2);
    font-weight: 700;
    padding: 13px 24px;
  }

  .btn--gold:hover {
    background: var(--gold-body);
    color: #fff;
  }

  /* --- Asset cards ---------------------------------------------------------- */
  .assetgrid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .assetcard {
    border: 1px solid var(--rule-card);
    border-top: 4px solid var(--level-assets);
    border-radius: var(--radius-panel);
    padding: 26px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    scroll-margin-top: 12px;
  }

  .assetcard__head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0 0 10px;
  }

  .assetcard__index {
    flex: none;
    letter-spacing: 0.16em;
  }

  .assetcard__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 26px;
    line-height: 1.2;
    color: var(--navy);
  }

  .assetcard__use {
    margin: 0 0 16px;
    font-size: var(--fs-3);
    line-height: 1.7;
    color: var(--text-strong);
  }

  .assetcard__note {
    margin: -6px 0 16px;
    font-size: var(--fs-2);
    line-height: 1.7;
    color: var(--gold-body);
    background: var(--level-assets-tint);
    border-left: 3px solid var(--level-assets);
    padding: 12px 16px;
  }

  .bullets--asset {
    --bullet-color: var(--level-assets-dark);
    gap: 10px;
  }

  .bullets--asset li {
    font-size: var(--fs-2);
    line-height: 1.65;
    padding-left: 15px;
    color: var(--text-body);
  }

  .assetcard__more {
    font-size: var(--fs-2);
    font-weight: 600;
    color: var(--level-assets-dark);
    text-decoration: none;
  }

  .assetcard__more:hover {
    text-decoration: underline;
    color: var(--level-assets-dark);
  }

  /* The six asset types whose own page has not been written yet. */
  .assetcard__more--pending {
    color: var(--text-subtle);
    cursor: default;
    pointer-events: none;
  }
</style>
