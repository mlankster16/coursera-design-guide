---
import PageLayout from '../layouts/PageLayout.astro';
import WorkedExample from '../components/WorkedExample.astro';
import BestPractice from '../components/BestPractice.astro';

const stats = [
  { figure: '2–4 learning objectives', label: 'per Course' },
  { figure: '3–6 modules', label: 'per Course' },
  { figure: '2–8 hours', label: 'of learner time' },
  { figure: 'Course Certificate', label: 'on completing the Course' },
];

const steps = [
  { id: 'step1', n: 1, label: 'Write objectives' },
  { id: 'step2', n: 2, label: 'Check objectives' },
  { id: 'step3', n: 3, label: 'Focus the scope' },
  { id: 'step4', n: 4, label: 'Design for flexibility' },
  { id: 'step5', n: 5, label: 'Complete the plan' },
];

/* Green scale, darkening across the five steps. */
const badge = ['#17724A', '#125E3D', '#0E4C31', '#0A3A25', '#1F2833'];

const ladder = [
  { level: 'Topic', focus: 'The subject or area the Course addresses', example: 'Business data' },
  {
    level: 'Knowledge',
    focus: 'What learners should know or understand about the topic',
    example: 'Characteristics of useful business data',
  },
  {
    level: 'Skill',
    focus: 'A specific capability learners can develop and demonstrate',
    example: 'Evaluate a dataset using defined quality criteria',
  },
  {
    level: 'Course-level objective',
    focus:
      'What learners will accomplish by applying their knowledge and skill in a meaningful context',
    example:
      'Determine whether available data is relevant, complete, and suitable for addressing a business question',
    strong: true,
  },
];

const goodVerbs = [
  'analyze',
  'apply',
  'create',
  'compare',
  'design',
  'evaluate',
  'identify',
  'interpret',
  'recommend',
  'communicate',
];

const weakVerbs = ['understand', 'learn', 'know', 'become familiar with', 'explore'];

const translations = [
  { verb: 'Evaluate', rest: ' a dataset for relevance and completeness.' },
  { verb: 'Recommend', rest: ' a data source for a specific business question.' },
  { verb: 'Design', rest: ' a simple analysis plan to address a business need.' },
];

const checks = [
  {
    q: 'Is it observable?',
    a: 'Can learners demonstrate the objective through something they <strong>do, create, analyze, evaluate, or decide</strong>?',
  },
  {
    q: 'Is it achievable within this Course?',
    a: 'Can learners reasonably achieve the objective through the course’s instruction, practice, feedback, and assessment?',
  },
  {
    q: 'Is it meaningful to learners?',
    a: 'Does the objective describe a capability learners can use beyond the course in a professional, academic, or other real-world context?',
  },
  {
    q: 'Is it appropriate for a self-paced online experience?',
    a: 'Can learners develop and demonstrate the capability through the course activities and assessments, without depending on live discussion, immediate instructor support, or synchronous participation?',
  },
  {
    q: 'Does it fit the larger learning pathway?',
    a: 'If the course is part of a specialization, certificate, or program, do its objectives support the broader pathway goals while giving the course a clear purpose of its own?',
  },
];

const objectives = [
  'Translate a business need into a focused question that can be investigated with data.',
  'Identify the data needed to investigate a business question.',
  'Evaluate a dataset for relevance, completeness, and basic quality concerns.',
  'Prepare a simple dataset for an introductory business analysis.',
];

const scopeQuestions = [
  'What knowledge or skills will learners gain from this?',
  'Do learners need it to achieve a course objective?',
  'Will it give learners an opportunity to practice or demonstrate what they should be able to do?',
];

const includeItems = [
  'identify the data fields relevant to a business question;',
  'check for missing, duplicate, or inconsistent values;',
  'restructure and format a simple dataset; and',
  'document data-preparation decisions.',
];

const excludeItems = [
  'advanced statistical modeling;',
  'complex programming techniques;',
  'large-scale data engineering; or',
  'specialized methods that are not used in the Course analysis.',
];

const taggedSkills = [
  'Business Problem Framing',
  'Data Requirements Analysis',
  'Data Quality Assessment',
  'Spreadsheet Analysis',
  'Exploratory Data Analysis',
];
---

<PageLayout
  title="Course"
  description="How to design a Coursera Course: write and check objectives, focus the scope, and complete the plan."
  level="course"
>
  <div class="levelpage" data-level="course">
    <!-- Hero -->
    <div class="hero" data-cap="head">
      <div>
        <p class="eyebrow hero__eyebrow">Course</p>
        <h1 class="hero__title">Designing a Coursera Course</h1>
        <p class="hero__lead">
          A well-designed Course brings together knowledge and skills that learners can apply in a
          meaningful context. Define what learners should be able to do by the end of the Course,
          then use the Course-level objectives to organize the Modules and align learning activities
          with instruction, practice, feedback, and assessment.
        </p>
      </div>

      <div class="hero__rail">
        <p class="eyebrow hero__rail-eyebrow">A Course at a glance</p>
        <div class="hero__stats">
          {
            stats.map((s) => (
              <div>
                <p class="hero__stat-figure">{s.figure}</p>
                <p class="hero__stat-label">{s.label}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Step jump rail -->
    <nav class="steprail steprail--5" aria-label="Steps on this page">
      {
        steps.map((s) => (
          <a class="steprail__link" href={`#${s.id}`}>
            <span class="steprail__n">{s.n}</span>
            <span class="steprail__label">{s.label}</span>
          </a>
        ))
      }
    </nav>

    <!-- Step 1 -->
    <section class="step" id="step1">
      <div class="step__head">
        <span class="step__badge" style={`--badge:${badge[0]}`}>1</span>
        <span class="step__count">Step 1 of 5</span>
      </div>
      <h2 class="step__title">Write Course objectives</h2>
      <p class="step__p step__p--gap">
        Once the Course has a clear purpose, translate that purpose into 2–4 Course-level learning
        objectives. Use the table below to move from the subject of the Course to what learners will
        be able to demonstrate. A Course-level objective typically brings together relevant knowledge
        and skills in a meaningful context.
      </p>

      <div class="ladder" data-keep>
        <div class="ladder__row ladder__row--head">
          <div class="ladder__cell">Element</div>
          <div class="ladder__cell">What it helps identify</div>
          <div class="ladder__cell">Example</div>
        </div>
        {
          ladder.map((r) => (
            <div class="ladder__row">
              <div class="ladder__cell ladder__cell--level">{r.level}</div>
              <div class="ladder__cell ladder__cell--focus">{r.focus}</div>
              <div class:list={['ladder__cell', r.strong && 'ladder__cell--strong']}>
                {r.example}
              </div>
            </div>
          ))
        }
      </div>

      <h3 class="h3 h3--spaced">Draft your objectives</h3>
      <p class="step__p step__p--tight">Use the following stem to begin each objective:</p>
      <p class="stem">By the end of this Course, learners will be able to…</p>

      <div class="askpair" data-keep>
        <div class="askpair__good">
          <p class="eyebrow askpair__eyebrow">Consider using observable action verbs such as</p>
          <div class="verbs">
            {goodVerbs.map((v) => <span class="verb">{v}</span>)}
          </div>
        </div>
        <div class="askpair__weak">
          <p class="eyebrow askpair__eyebrow">Some verbs may need more specificity</p>
          <div class="verbs verbs--gap">
            {weakVerbs.map((v) => <span class="verb verb--weak">{v}</span>)}
          </div>
          <p class="verbs__note">
            These verbs may describe your instructional intention, but on their own, they do not
            clearly indicate what learners will be able to demonstrate.
          </p>
        </div>
      </div>

      <p class="step__p step__p--tight">
        Complete the verb with what learners will act on and, when helpful, the context or criteria.
        A broad instructional intention such as “<strong
          >understand how data can support a business decision</strong
        >” can be translated into different observable objectives, depending on what learners should
        demonstrate:
      </p>
      <ul class="qlist qlist--tight">
        {
          translations.map((t) => (
            <li>
              <strong>{t.verb}</strong>
              {t.rest}
            </li>
          ))
        }
      </ul>
      <p class="step__p step__p--gap">
        Choose the objective(s) that best match what learners should be able to demonstrate by the
        end of the Course.
      </p>

      <WorkedExample
        id="wx-objectives"
        lead="Writing Course objectives for"
        name="Foundations of Data Analytics for Business"
      >
        <p class="example__p example__p--lead">
          Throughout this guide, we use <strong>Data Analytics for Business Decisions</strong> as a
          worked example. On the Specialization page, you saw how its three Courses work together.
          Here, we’ll look more closely at the first Course, <strong
            >Foundations of Data Analytics for Business</strong
          >, and translate its purpose into Course-level objectives.
        </p>

        <div class="ctx">
          <div class="ctx__bar">
            <span><strong>Specialization</strong>: Data Analytics for Business Decisions</span>
          </div>
          <div class="ctx__body">
            <p class="ctx__course"><strong>Course 1</strong>: Foundations of Data Analytics for Business</p>
            <p class="ctx__p">
              Learners begin by translating a business need into a question that can be investigated
              with data. They identify the data they need, evaluate its basic quality, and prepare it
              for analysis.
            </p>
            <p class="ctx__leave">
              <strong>Learners leave with:</strong> a focused business question and a simple,
              analysis-ready dataset.
            </p>
          </div>
        </div>

        <p class="example__p">
          That purpose can be translated into a small set of observable Course-level objectives.
        </p>

        <div class="objbox">
          <p class="objbox__eyebrow">By the end of the Course, learners will be able to:</p>
          <ul class="objbox__list">
            {objectives.map((o) => <li>{o}</li>)}
          </ul>
        </div>

        <p class="example__p">
          These objectives describe what learners can demonstrate, rather than topics the instructor
          intends to cover. For example, <strong>“data quality”</strong> names a subject. <strong
            >“Evaluate a dataset for relevance, completeness, and common quality issues”</strong
          > describes what learners will do with their knowledge of that subject.
        </p>
      </WorkedExample>
    </section>

    <!-- Step 2 -->
    <section class="step" id="step2">
      <div class="step__head">
        <span class="step__badge" style={`--badge:${badge[1]}`}>2</span>
        <span class="step__count">Step 2 of 5</span>
      </div>
      <h2 class="step__title">Check your objectives</h2>

      <div class="checklist">
        {
          checks.map((c) => (
            <div class="checklist__row" data-keep>
              <span class="checklist__box" aria-hidden="true" />
              <div>
                <p class="checklist__q">{c.q}</p>
                <p class="checklist__a" set:html={c.a} />
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Step 3 -->
    <section class="step" id="step3">
      <div class="step__head">
        <span class="step__badge" style={`--badge:${badge[2]}`}>3</span>
        <span class="step__count">Step 3 of 5</span>
      </div>
      <h2 class="step__title">Focus the Course scope</h2>
      <p class="step__q">
        Now that you've checked your objectives, use them to guide decisions about the Course's
        scope.
      </p>
      <p class="step__p step__p--tight">For each topic, resource, or activity, ask:</p>

      <ul class="qlist">
        {scopeQuestions.map((q) => <li>{q}</li>)}
      </ul>

      <p class="step__p step__p--gap">
        Use your answers to decide what to include, leave out, or save for another Course. A strong
        Course is not simply a collection of related topics. Each element should help learners develop
        the knowledge and skills they need to achieve the intended outcomes.
      </p>

      <div class="askpair" data-keep>
        <div class="askpair__good">
          <p class="eyebrow askpair__eyebrow">You might ask</p>
          <p class="askpair__q">
            What knowledge and skills do learners need to achieve the Course objectives?
          </p>
        </div>
        <div class="askpair__weak">
          <p class="eyebrow askpair__eyebrow">Rather than asking</p>
          <p class="askpair__q">Which topics should this Course cover?</p>
        </div>
      </div>

      <WorkedExample id="wx-scope" lead="Using a Course objective to" name="guide scope">
        <p class="example__p">Consider one objective from Course 1:</p>

        <div class="objbox">
          <p class="objbox__eyebrow">Course objective</p>
          <p class="objbox__quote">
            Learners will be able to prepare a simple dataset for an introductory business analysis.
          </p>
        </div>

        <p class="example__p example__p--gap">
          This objective helps faculty distinguish between content that directly supports the
          intended learning and content that, while interesting or valuable, may not be necessary in
          this Course.
        </p>

        <div class="inout">
          <div class="inout__card inout__card--in">
            <p class="eyebrow inout__eyebrow">Include</p>
            <p class="inout__intro">Learners will likely need opportunities to:</p>
            <ul class="inout__list">
              {includeItems.map((i) => <li>{i}</li>)}
            </ul>
            <p class="inout__note">
              Each element contributes directly to learners’ ability to prepare data for an
              introductory analysis.
            </p>
          </div>
          <div class="inout__card inout__card--out">
            <p class="eyebrow inout__eyebrow">Consider leaving out</p>
            <p class="inout__intro">Learners may not need:</p>
            <ul class="inout__list">
              {excludeItems.map((i) => <li>{i}</li>)}
            </ul>
            <p class="inout__note">
              These topics may be valuable in another context, but they are not necessary for
              achieving this Course objective. Including them could increase the Course’s time and
              complexity without adding to the skill learners are expected to develop.
            </p>
          </div>
        </div>
      </WorkedExample>
    </section>

    <!-- Step 4 -->
    <section class="step" id="step4">
      <div class="step__head">
        <span class="step__badge" style={`--badge:${badge[3]}`}>4</span>
        <span class="step__count">Step 4 of 5</span>
      </div>
      <h2 class="step__title">Design for flexibility</h2>
      <p class="step__p">
        Coursera Courses often work well when they are modular and self-contained. When possible,
        provide enough context for learners to understand the Course's purpose, why the learning
        matters, and what prior knowledge or skills they need to succeed without requiring them to
        have completed a specific earlier Course.
      </p>
      <p class="step__p step__p--gap">
        Some subjects are best learned through a sequence. When learners genuinely need knowledge or
        skills from an earlier Course, make that dependency clear. The goal is not to eliminate
        prerequisites, but to make Courses as portable and understandable on their own as the
        learning allows.
      </p>

      <div class="askpair" data-keep>
        <div class="askpair__good">
          <p class="eyebrow askpair__eyebrow">More modular</p>
          <p class="askpair__quote">
            This Course assumes familiarity with basic spreadsheet formulas and functions.
          </p>
        </div>
        <div class="askpair__weak">
          <p class="eyebrow askpair__eyebrow">More dependent on a specific sequence</p>
          <p class="askpair__quote">
            As you learned in Course 1, you will now build on the framework introduced in Module 3…
          </p>
        </div>
      </div>
    </section>

    <!-- Step 5: template -->
    <section class="step step--last" id="step5">
      <div class="step__head">
        <span class="step__badge" style={`--badge:${badge[4]}`}>5</span>
        <span class="step__count">Step 5 of 5</span>
      </div>
      <h2 class="step__title">Complete your Course plan</h2>
      <p class="step__q">
        Use this page to work through the course-design decisions, then record them in the Design
        Document. The sample below shows how those decisions might come together for <strong
          >Course 1: Foundations of Data Analytics</strong
        > in the example <strong
          >Specialization: <span class="nostyle">Data Analytics for Business Decisions</span></strong
        >. Use it as a reference as you develop your own plan.
      </p>

      <div class="tmpl">
        <div class="tmpl__bar">
          <span class="tmpl__bar-title">Course 1</span>
          <span class="tmpl__bar-note">Repeats per Course</span>
        </div>

        <div class="tmpl__link-row">
          <a
            class="ext"
            href="https://www.coursera.org/search?query=duke%20university"
            target="_blank"
            rel="noopener">See a sample Course Landing Page ↗</a
          > on Coursera
        </div>

        <div class="tmpl__field">
          <div class="tmpl__labelrow">
            <p class="tmpl__label">Course title</p>
            <BestPractice title="Course title">
              <p>
                Write for the learner deciding whether this Course is relevant to them. A strong
                title makes the <strong>topic and learner value immediately clear</strong> while
                giving the Course a distinct purpose. Favor specific, familiar language over academic
                numbering or internal terminology.
              </p>
            </BestPractice>
          </div>
          <div class="tmpl__value"><p>Foundations of Data Analytics for Business</p></div>
        </div>

        <div class="tmpl__field">
          <div class="tmpl__labelrow">
            <p class="tmpl__label">Course description</p>
            <BestPractice title="Course description">
              <p>
                Describe the Course from the learner's perspective. Lead with what learners will
                <strong>gain or be able to do</strong>, rather than with a list of topics. Provide
                enough context for the Course to make sense on its own, even when it is part of a
                larger learning pathway.
              </p>
            </BestPractice>
          </div>
          <div class="tmpl__value">
            <p>
              Designed for professionals, students, and career changers who want to use data more
              effectively in business settings, this beginner-level course introduces the process of
              turning a business need into a question that data can help answer. Learners will
              practice framing business questions, identifying data requirements, evaluating data for
              relevance and quality, and preparing a simple dataset for analysis.
            </p>
            <p>
              Through realistic business examples, guided practice, quizzes, and applied activities,
              learners will build foundational skills in business problem framing, data requirements
              analysis, data quality assessment, and spreadsheet-based data preparation. These skills
              can help learners communicate more effectively with data professionals, make more
              informed decisions, and prepare for further study or roles involving business
              analytics.
            </p>
            <p>
              Taught by Jordan Lee, a faculty member specializing in business analytics and
              evidence-informed decision-making, the course offers an applied, self-paced
              introduction to the full process from business question to analysis-ready dataset.
            </p>
          </div>
        </div>

        <div class="tmpl__row">
          <div class="tmpl__field">
            <div class="tmpl__labelrow">
              <p class="tmpl__label">Estimated time to complete</p>
              <BestPractice title="Estimated time to complete">
                <p>
                  Estimate the learner's <strong>total experience</strong>, including videos,
                  readings, practice, activities, and assessments — not just instructional content.
                  Keep the scope realistic for a self-paced Coursera Course that learners may
                  complete in shorter sessions around other responsibilities.
                </p>
              </BestPractice>
            </div>
            <div class="tmpl__value"><p>Approximately 7 hours</p></div>
          </div>
          <div class="tmpl__field">
            <div class="tmpl__labelrow">
              <p class="tmpl__label">Difficulty level</p>
              <BestPractice title="Difficulty level" align="right">
                <p>
                  Choose the level based on the <strong
                    >knowledge, skills, and independence learners need to succeed</strong
                  >, not on how sophisticated the subject sounds. A complex topic can still be
                  appropriate for beginners when foundational concepts and sufficient support are
                  built into the Course.
                </p>
              </BestPractice>
            </div>
            <div class="tmpl__value"><p>Beginner</p></div>
          </div>
        </div>

        <div class="tmpl__row">
          <div class="tmpl__field">
            <div class="tmpl__labelrow">
              <p class="tmpl__label">Primary domain / sub-domain</p>
              <BestPractice title="Primary domain / sub-domain">
                <p>
                  Choose the category that most directly reflects the <strong
                    >Course's primary subject and learner value</strong
                  >. Use the most specific appropriate Coursera domain rather than trying to
                  represent every discipline the Course touches.
                </p>
              </BestPractice>
            </div>
            <div class="tmpl__value"><p>Business → Business Analytics</p></div>
          </div>
          <div class="tmpl__field">
            <div class="tmpl__labelrow">
              <p class="tmpl__label">Secondary domain / sub-domain</p>
              <BestPractice title="Secondary domain / sub-domain" align="right">
                <p>
                  Use a secondary domain when another area meaningfully represents the Course. It
                  should describe a substantial part of the learning experience, not simply broaden
                  discoverability.
                </p>
              </BestPractice>
            </div>
            <div class="tmpl__value"><p>Data Science → Data Analysis</p></div>
          </div>
        </div>

        <div class="tmpl__field">
          <div class="tmpl__labelrow">
            <p class="tmpl__label">Tagged skills</p>
            <BestPractice title="Tagged skills">
              <p>
                Choose <strong
                  >specific skills learners will actively practice or demonstrate in this Course</strong
                >. Avoid broad subject labels, and select tags that align closely with the Course
                objectives, activities, and assessments.
              </p>
            </BestPractice>
          </div>
          <div class="tmpl__chips">
            {taggedSkills.map((s) => <span class="tmpl__chip">{s}</span>)}
          </div>
        </div>

        <div class="tmpl__field">
          <div class="tmpl__labelrow">
            <p class="tmpl__label">Recommended background</p>
            <BestPractice title="Recommended background">
              <p>
                Include only the knowledge or experience learners <strong
                  >actually need before beginning the Course</strong
                >. Distinguish true prerequisites from experience that may simply be helpful, and
                avoid creating unnecessary barriers for otherwise appropriate learners.
              </p>
            </BestPractice>
          </div>
          <div class="tmpl__value">
            <p>
              No prior experience with data analytics or programming is required. Basic familiarity
              with spreadsheets and workplace mathematics may be helpful.
            </p>
          </div>
        </div>

        <div class="tmpl__field">
          <div class="tmpl__labelrow">
            <p class="tmpl__label">What learners will learn</p>
            <BestPractice title="What learners will learn">
              <p>
                Write <strong>2–4 observable, measurable Course objectives</strong> that describe
                meaningful capabilities learners should be able to demonstrate by the end of the
                Course. Objectives should be achievable within the Course and valuable to learners
                beyond simply completing it.
              </p>
              <p>
                Begin with action verbs such as <strong
                  >analyze, apply, create, evaluate, identify, interpret, recommend,</strong
                > or <strong>communicate</strong>. Verbs such as <em>understand, learn,</em> or <em
                  >become familiar with</em
                > may describe your instructional intention, but they do not clearly indicate what
                learners will be able to demonstrate.
              </p>
            </BestPractice>
          </div>
          <div class="tmpl__value">
            <ol>
              {objectives.map((o) => <li>{o}</li>)}
            </ol>
          </div>
        </div>

        <div class="tmpl__field">
          <div class="tmpl__labelrow">
            <p class="tmpl__label">Instructor information and bio source link</p>
            <BestPractice title="Instructor information and bio source link">
              <p>
                Provide concise, learner-facing information that establishes the instructor's <strong
                  >relevant expertise and connection to the Course topic</strong
                >. Prioritize experience that helps learners understand why this instructor is well
                positioned to guide the learning experience.
              </p>
              <p>
                If an approved faculty bio and headshot already exist, provide a build-ready source
                link rather than recreating the material.
              </p>
            </BestPractice>
          </div>
          <div class="tmpl__value">
            <p>
              <strong>Jordan Lee</strong> is a faculty member specializing in business analytics and
              evidence-informed decision-making. Their teaching and research focus on helping
              organizations frame questions, evaluate performance, and use data to make more informed
              decisions.
            </p>
          </div>
        </div>

        <div class="tmpl__cta">
          <a class="btn btn--level" href="#" data-template-link>Open the template in Google Docs ↗</a>
        </div>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .steprail--5 {
    grid-template-columns: repeat(5, 1fr);
  }

  .step--last {
    padding-bottom: 8px;
  }

  .step__p--gap {
    margin-bottom: 36px;
  }

  .step__p--tight {
    margin-bottom: 16px;
  }

  .nostyle {
    font-style: normal;
  }

  /* --- Objective ladder --------------------------------------------------- */
  .ladder {
    border: 1px solid var(--rule-card);
    border-radius: var(--radius-panel);
    overflow: hidden;
    margin: 0 0 32px;
  }

  .ladder__row {
    display: grid;
    grid-template-columns: 170px 1fr 1.4fr;
    border-bottom: 1px solid var(--rule);
  }

  .ladder__row:last-child {
    border-bottom: 0;
  }

  .ladder__row--head {
    background: var(--tint);
