---
/* An ⓘ button beside a template field label that opens a "Best practice"
   popover. Single-open across the page: opening one closes any other.
   Closes on ✕, on Escape, and on a click outside.

   Colors come from the enclosing .levelpage via --accent / --accent-dark /
   --tint-border, so the popover matches its page. Pass tone="gold" for the
   Learning-Assets-flavored fields (the Module asset table). */

interface Props {
  /** Popover heading — usually the field label, sentence-cased. */
  title: string;
  /** Screen-reader label for the trigger. Defaults from `title`. */
  label?: string;
  tone?: 'level' | 'gold';
  /** Which edge the popover aligns to. Use 'right' near the page edge. */
  align?: 'left' | 'right';
  /** Smaller trigger, for use inside a dense table header. */
  size?: 'md' | 'sm';
  width?: number;
}
const { title, label, tone = 'level', align = 'left', size = 'md', width = 420 } = Astro.props;
---

<span
  class:list={['bp', `bp--${tone}`, `bp--${size}`, `bp--${align}`]}
  data-bp
  style={`--bp-w:${width}px`}
>
  <button class="bp__trigger" type="button" aria-expanded="false" aria-label={label ?? `Guidance for ${title}`}>
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.9"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M12 16v-4"></path>
      <path d="M12 8h.01"></path>
    </svg>
  </button>

  <span class="bp__pop" role="dialog" aria-label={`Best practice: ${title}`} hidden>
    <span class="bp__head">
      <span>
        <span class="bp__eyebrow">Best practice</span>
        <span class="bp__title">{title}</span>
      </span>
      <button class="bp__close" type="button" aria-label="Close">✕</button>
    </span>
    <span class="bp__body"><slot /></span>
  </span>
</span>

<style>
  .bp {
    /* The popover is positioned against this, so the field-label row it
       sits in must not itself be the positioning context. */
    position: relative;
    display: inline-flex;
    align-items: center;
    flex: none;
  }

  .bp--level {
    --bp-accent: var(--accent);
    --bp-accent-dark: var(--accent-dark);
    --bp-border: var(--tint-border);
  }

  .bp--gold {
    --bp-accent: var(--level-assets);
    --bp-accent-dark: var(--level-assets-dark);
    --bp-border: var(--level-assets-tint-border);
  }

  .bp__trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--bp-border);
    background: #fff;
    color: var(--bp-accent-dark);
    cursor: pointer;
  }

  .bp--sm .bp__trigger {
    width: 18px;
    height: 18px;
  }

  .bp__trigger svg {
    width: 14px;
    height: 14px;
    display: block;
  }

  .bp--sm .bp__trigger svg {
    width: 12px;
    height: 12px;
  }

  .bp__trigger:hover {
    border-color: var(--bp-accent);
  }

  .bp__trigger:focus-visible {
    outline: 2px solid var(--bp-accent);
    outline-offset: 2px;
  }

  .bp__trigger[aria-expanded='true'] {
    background: var(--bp-accent);
    color: #fff;
    border-color: var(--bp-accent);
  }

  .bp__pop {
    position: absolute;
    z-index: 40;
    top: calc(100% + 8px);
    width: var(--bp-w);
    max-width: var(--bp-w);
    display: block;
    background: #fff;
    border: 1px solid var(--bp-border);
    border-top: 3px solid var(--bp-accent);
    border-radius: var(--radius-panel);
    box-shadow: 0 10px 34px rgba(1, 33, 105, 0.16);
    padding: 20px 22px;
    text-align: left;
    /* Field labels carry nowrap; the popover prose must wrap. */
    white-space: normal;
  }

  .bp__pop[hidden] {
    display: none;
  }

  .bp--left .bp__pop {
    left: 0;
  }

  .bp--right .bp__pop {
    right: 0;
  }

  .bp__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    margin: 0 0 10px;
  }

  .bp__eyebrow {
    display: block;
    margin: 0 0 3px;
    font-size: var(--fs-1);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bp-accent-dark);
    font-weight: 700;
  }

  .bp__title {
    display: block;
    font-family: var(--font-display);
    font-size: var(--fs-5);
    line-height: 1.25;
    color: var(--navy);
  }

  .bp__close {
    flex: none;
    padding: 2px 3px;
    border: 0;
    background: none;
    cursor: pointer;
    font-size: var(--fs-3);
    line-height: 1;
    color: var(--text-subtle);
  }

  .bp__close:hover {
    color: var(--text-strong);
  }

  .bp__body {
    display: block;
    font-size: var(--fs-2);
    line-height: 1.7;
    color: var(--text-body);
    font-weight: 400;
  }

  .bp__body :global(p) {
    margin: 0 0 10px;
  }

  .bp__body :global(p:last-child) {
    margin-bottom: 0;
  }

  .bp__body :global(strong) {
    color: var(--text-strong);
  }

  /* Guidance is reference material for the person filling in the template,
     not part of the plan, so it is left out of the PDF. */
  @media print {
    .bp {
      display: none;
    }
  }
</style>

<script>
  (() => {
    const groups = [...document.querySelectorAll<HTMLElement>('[data-bp]')];
    if (!groups.length) return;

    const parts = (g: HTMLElement) => ({
      trigger: g.querySelector<HTMLButtonElement>('.bp__trigger')!,
      pop: g.querySelector<HTMLElement>('.bp__pop')!,
    });

    const closeAll = (except?: HTMLElement) => {
      groups.forEach((g) => {
        if (g === except) return;
        const { trigger, pop } = parts(g);
        pop.hidden = true;
        pop.style.top = '';
        pop.style.bottom = '';
        pop.style.transform = '';
        trigger.setAttribute('aria-expanded', 'false');
      });
    };

    /* Keep the popover inside the page card. The card clips its own
       overflow, so a popover on one of the lower fields would otherwise be
       cut off: flip it above the trigger when there is not room below, and
       nudge it sideways when it would run past an edge. */
    const place = (g: HTMLElement, pop: HTMLElement) => {
      pop.style.top = '';
      pop.style.bottom = '';
      pop.style.transform = '';

      const bounds = (g.closest('.shell') ?? document.documentElement).getBoundingClientRect();
      const trigger = parts(g).trigger.getBoundingClientRect();
      let r = pop.getBoundingClientRect();
      const gutter = 8;

      const spillsBelow = r.bottom > bounds.bottom - gutter;
      const roomAbove = trigger.top - bounds.top;
      const roomBelow = bounds.bottom - trigger.bottom;
      if (spillsBelow && roomAbove > roomBelow) {
        pop.style.top = 'auto';
        pop.style.bottom = 'calc(100% + 8px)';
        r = pop.getBoundingClientRect();
      }

      let dx = 0;
      if (r.right > bounds.right - gutter) dx = bounds.right - gutter - r.right;
      else if (r.left < bounds.left + gutter) dx = bounds.left + gutter - r.left;
      if (dx) pop.style.transform = `translateX(${Math.round(dx)}px)`;
    };

    groups.forEach((g) => {
      const { trigger, pop } = parts(g);

      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const willOpen = pop.hidden;
        closeAll(g);
        pop.hidden = !willOpen;
        if (willOpen) place(g, pop);
        trigger.setAttribute('aria-expanded', String(willOpen));
      });

      g.querySelector<HTMLButtonElement>('.bp__close')!.addEventListener('click', () => {
        pop.hidden = true;
        trigger.setAttribute('aria-expanded', 'false');
        trigger.focus();
      });

      // Clicks inside the popover must not reach the document handler.
      pop.addEventListener('click', (e) => e.stopPropagation());
    });

    document.addEventListener('click', () => closeAll());
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAll();
    });
    window.addEventListener('beforeprint', () => closeAll());
  })();
</script>
