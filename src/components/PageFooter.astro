---
import { neighbours, levelColor, url, type LevelKey } from '../data/site';

interface Props {
  /** The page's own level. Footer shows its hierarchy neighbours. */
  level?: LevelKey;
  /** Sub-pages (Video, Reading) show a single "← Back to" link instead. */
  backTo?: { label: string; href: string; color: string };
  /** Replaces the hierarchy's "Zoom in" link where a page leads somewhere
      other than the next level down. */
  nextTo?: { dir: string; label: string; href: string; color: string };
}
const { level, backTo, nextTo } = Astro.props;

const chain = level ? neighbours(level) : { prev: undefined, next: undefined };
const prev = chain.prev;
const next = nextTo ? undefined : chain.next;
const single = Boolean(backTo) ? !nextTo : !prev || (!next && !nextTo);
---

{
  (prev || next || backTo || nextTo) && (
    <div class:list={['pagefoot', single && 'pagefoot--single']}>
      {backTo ? (
        <a href={url(backTo.href)}>
          <span class="pagefoot__dir">← Back to</span>
          <span class="pagefoot__name" style={`color:${backTo.color}`}>
            {backTo.label}
          </span>
        </a>
      ) : (
        prev && (
          <a href={url(prev.href)}>
            <span class="pagefoot__dir">← Zoom out</span>
            <span class="pagefoot__name" style={`color:${levelColor[prev.key]}`}>
              {prev.label}
            </span>
          </a>
        )
      )}

      {!backTo && next && (
        <a class="pagefoot__next" href={url(next.href)}>
          <span class="pagefoot__dir">Zoom in →</span>
          <span class="pagefoot__name" style={`color:${levelColor[next.key]}`}>
            {next.label}
          </span>
        </a>
      )}

      {nextTo && (
        <a class="pagefoot__next" href={url(nextTo.href)}>
          <span class="pagefoot__dir">{nextTo.dir}</span>
          <span class="pagefoot__name" style={`color:${nextTo.color}`}>
            {nextTo.label}
          </span>
        </a>
      )}
    </div>
  )
}
