---
/* A collapsible worked example. The header is the toggle; the body sits in
   a panel below it. Each example opens and closes independently, and all of
   them force open before printing so the PDF the client circulates keeps
   every example.

   Colors come from the enclosing .levelpage via --accent / --accent-dark /
   --tint / --tint-border / --wash. */

interface Props {
  /** Normal-weight prefix, e.g. "Writing Module objectives for". */
  lead: string;
  /** Bold subject, e.g. "Identifying and Evaluating Business Data". */
  name: string;
  id: string;
  /** Open on first paint. Examples default to collapsed. */
  open?: boolean;
}
const { lead, name, id, open = false } = Astro.props;
---

<div class="wx" data-wx data-open={String(open)}>
  <button class="wx__head" type="button" aria-expanded={String(open)} aria-controls={`${id}-body`}>
    <span class="wx__headings">
      <span class="wx__eyebrow">Worked example</span>
      <span class="wx__title"><span class="wx__lead">{lead} </span>{name}</span>
    </span>
    <span class="wx__toggle">{open ? 'Hide example' : 'Show example'}</span>
  </button>

  <div class="wx__body" id={`${id}-body`}>
    <slot />
  </div>
</div>

<style>
  .wx {
    margin: 0 0 36px;
  }

  .wx__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    text-align: left;
    font: inherit;
    background: var(--tint);
    border: 1px solid var(--tint-border);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius-panel);
    padding: 18px 24px;
    cursor: pointer;
  }

  .wx__head:hover {
    filter: brightness(0.985);
  }

  .wx__head:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Square off the join when the body below is showing. */
  .wx[data-open='true'] .wx__head {
    border-radius: var(--radius-panel) var(--radius-panel) 0 0;
  }

  .wx__headings {
    display: block;
  }

  .wx__eyebrow {
    display: block;
    margin: 0 0 3px;
    font-size: var(--fs-1);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-dark);
    font-weight: 700;
  }

  .wx__title {
    display: block;
    font-family: var(--font-display);
    font-size: var(--fs-5);
    font-weight: 700;
    color: var(--navy);
  }

  .wx__lead {
    font-weight: 400;
  }

  .wx__toggle {
    flex: none;
    font-size: var(--fs-2);
    font-weight: 700;
    color: var(--accent-dark);
    white-space: nowrap;
  }

  .wx__body {
    border: 1px solid var(--tint-border);
    border-top: none;
    border-radius: 0 0 var(--radius-panel) var(--radius-panel);
    background: var(--wash);
    padding: 30px 34px;
  }

  .wx[data-open='false'] .wx__body {
    display: none;
  }

  @media print {
    /* Every example is expanded for the PDF, and the toggle is meaningless
       on paper. */
    .wx__body {
      display: block !important;
    }
    .wx__toggle {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-wx]').forEach((wx) => {
    const head = wx.querySelector<HTMLButtonElement>('.wx__head')!;
    const toggle = wx.querySelector<HTMLElement>('.wx__toggle')!;

    const set = (open: boolean) => {
      wx.dataset.open = String(open);
      head.setAttribute('aria-expanded', String(open));
      toggle.textContent = open ? 'Hide example' : 'Show example';
    };

    head.addEventListener('click', () => set(wx.dataset.open !== 'true'));

    let before = false;
    window.addEventListener('beforeprint', () => {
      before = wx.dataset.open === 'true';
      set(true);
    });
    window.addEventListener('afterprint', () => set(before));
  });
</script>
