---
import { pages, assetLinks, assetHref, sharedGuidance, levelColor, url, type LevelKey } from '../data/site';

interface Props {
  /** Which top-level item is active. Learning Asset sub-pages pass 'assets'. */
  active: LevelKey;
}
const { active } = Astro.props;
---

<div class="masthead">
  <a href={url('/')}>
    <img
      src={url('/assets/ctl-logo-white.png')}
      alt="Duke Learning Innovation and Lifetime Education — Center for Teaching and Learning"
    />
  </a>
</div>

<nav class="nav" aria-label="Site">
  <a class="nav__wordmark" href={url('/')}>Coursera Design Guide</a>

  <div class="nav__items">
    {
      pages.map((p) =>
        p.key === 'assets' ? (
          <div class="nav__group" data-assets-menu>
            <a
              class="nav__link nav__link--group"
              href={url(p.href)}
              style={`--nav-accent:${levelColor.assets}`}
              aria-current={active === 'assets' ? 'page' : undefined}
            >
              {p.label}
              <span class="nav__caret" aria-hidden="true">⌄</span>
            </a>

            <button
              class="nav__toggle"
              type="button"
              aria-expanded="false"
              aria-controls="assets-menu"
            >
              <span class="visually-hidden">Show all Learning Assets</span>
            </button>

            <ul class="nav__dropdown" id="assets-menu" hidden>
              <li>
                <a class="nav__dd-link nav__dd-link--all" href={url('/learning-assets')}>
                  All Learning Assets
                </a>
              </li>
              <li>
                <a class="nav__dd-link nav__dd-link--featured" href={url(sharedGuidance.href)}>
                  {sharedGuidance.label}
                </a>
              </li>
              {
                assetLinks.map((a) => (
                  <li>
                    <a class="nav__dd-link" href={url(assetHref(a))} data-built={a.page ? 'true' : 'false'}>
                      {a.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        ) : (
          <a
            class="nav__link"
            href={url(p.href)}
            style={`--nav-accent:${levelColor[p.key]}`}
            aria-current={active === p.key ? 'page' : undefined}
          >
            {p.label}
          </a>
        )
      )
    }
  </div>
</nav>

<style>
  .nav__group {
    position: relative;
    display: flex;
    align-items: center;
  }

  .nav__link--group {
    display: inline-flex;
    align-items: baseline;
    gap: 5px;
  }

  .nav__caret {
    font-size: 9px;
    line-height: 1;
    position: relative;
    top: -1px;
  }

  /* The whole item is one hit area: the link navigates, the invisible
     button overlays the caret so keyboard and screen-reader users can
     open the menu without leaving the page. */
  .nav__toggle {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 16px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .nav__toggle:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
  }

  .nav__dropdown {
    position: absolute;
    top: calc(100% + 14px);
    right: 0;
    z-index: 20;
    margin: 0;
    padding: 8px 0;
    list-style: none;
    width: 330px;
    background: #fff;
    border: 1px solid var(--rule-card);
    border-top: 4px solid var(--level-assets);
    border-radius: var(--radius-panel);
    box-shadow: 0 12px 34px rgba(1, 33, 105, 0.16);
  }

  .nav__dropdown[hidden] {
    display: none;
  }

  .nav__dd-link {
    display: block;
    padding: 9px 24px;
    /* 16px sits between --fs-2 and --fs-3 and is the design's value here,
       as it is for the chooser blurbs and share-panel bullets. */
    font-size: 16px;
    letter-spacing: 0.02em;
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav__dd-link:hover,
  .nav__dd-link:focus-visible {
    background: var(--level-assets-tint);
    color: var(--level-assets-dark);
  }

  .nav__dd-link--all {
    padding: 14px 24px;
    font-size: var(--fs-3);
    font-weight: 600;
    color: var(--navy);
  }

  /* Accessibility, copyright and AI apply to every asset, so this is the
     one child faculty need most — the only emphasized item in the menu. */
  .nav__dd-link--featured {
    font-size: 16px;
    margin: 6px 0;
    padding: 13px 24px 13px 21px;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    border-left: 3px solid var(--level-assets);
    background: var(--level-assets-tint);
    font-weight: 700;
    color: var(--navy);
    line-height: 1.4;
    white-space: normal;
  }

  .nav__dd-link--featured:hover,
  .nav__dd-link--featured:focus-visible {
    background: #fbefd9;
    color: var(--navy);
  }

  /* Assets without a page of their own jump to their section on the
     Learning Assets page. Muted rather than marked — the design asks for
     no descriptor text in the menu. */
  .nav__dd-link[data-built='false'] {
    color: var(--text-subtle);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script>
  const group = document.querySelector<HTMLElement>('[data-assets-menu]');
  if (group) {
    const toggle = group.querySelector<HTMLButtonElement>('.nav__toggle')!;
    const menu = group.querySelector<HTMLElement>('.nav__dropdown')!;
    let hoverTimer: number | undefined;

    const caret = group.querySelector<HTMLElement>('.nav__caret')!;

    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      caret.textContent = open ? '⌃' : '⌄';
    };

    // Pointer: open on hover, with a short close delay so the diagonal
    // trip from the nav item to the menu does not dismiss it.
    group.addEventListener('mouseenter', () => {
      window.clearTimeout(hoverTimer);
      setOpen(true);
    });
    group.addEventListener('mouseleave', () => {
      hoverTimer = window.setTimeout(() => setOpen(false), 180);
    });

    // Keyboard / click on the caret.
    toggle.addEventListener('click', (e) => {
      e.preventDefault();
      setOpen(menu.hidden);
    });

    group.addEventListener('focusin', () => setOpen(true));
    group.addEventListener('focusout', (e) => {
      if (!group.contains(e.relatedTarget as Node)) setOpen(false);
    });

    toggle.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        setOpen(true);
        menu.querySelector<HTMLAnchorElement>('.nav__dd-link')?.focus();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
